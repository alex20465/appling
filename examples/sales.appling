// Order management: one module across all five layers.
module sales {
  export Order, OrderSummary, OpenOrders, PlaceOrder, Customer

  role Customer
  actor human Shopper roles Customer {
    account: crm.Account
  }

  // L1 Domain
  enum OrderStatus {
    draft
    placed
    paid
    cancelled
  }

  value Line {
    product: String
    quantity: Int
    amount: Money
  }

  entity Order {
    reference: String unique
    customer: crm.Account
    lines: Line[] owned
    status: OrderStatus state default draft
    created_at: DateTime
    placed_at: DateTime?
    paid_at: DateTime?
    total: Money = sum(lines.map(l, l.amount))

    invariant "total never negative" { total >= 0 }

    policy read { actor.is(crm.Clerk) || (actor.is(Customer) && customer == actor.account) }
    policy create, update, delete { actor.is(crm.Clerk) }
    policy read fields total { actor.is(crm.Clerk) || (actor.is(Customer) && status != draft) }
  }

  // L2 Behavior
  event OrderPlaced {
    order: Order
  }
  event PaymentReceived {
    order: Order
  }

  action PlaceOrder on Order {
    requires { lines.size() > 0 } else EmptyOrder
    effect {
      set placed_at = now
    }
    errors EmptyOrder
    policy { actor.is(Customer) && customer == actor.account }
  }

  action Cancel on Order {
    input {
      reason: String?
    }
    policy { actor.is(crm.Clerk) }
  }

  machine OrderFlow on Order.status {
    transition draft -> placed via PlaceOrder effect { emit OrderPlaced { order = this } }
    transition placed -> paid on PaymentReceived
    transition draft, placed -> cancelled via Cancel when { !has(paid_at) }
  }

  job ExpireDrafts every "0 3 * * *" run Cancel where { status == draft && created_at < now - duration("720h") }

  // L3 Application
  query OpenOrders from Order {
    where { status in [placed, paid] }
    sort placed_at desc
    paginate 50
  }

  projection OrderSummary from Order {
    reference
    status
    total
    customer_name = customer.name
  }

  external Payments {
    op Charge (amount: Money) returns String errors Declined
  }

  usecase Checkout (order: Order) {
    step PlaceOrder(order)
    step Payments.Charge(order.total) on Declined do Cancel(order)
    await PaymentReceived timeout "24h" do Cancel(order)
  }

  // L4 Interfaces
  interface rest PublicApi {
    auth bearer
    limit 100 per minute
    GET "/orders" -> OpenOrders as OrderSummary { reference, status, total }
    POST "/orders/{id}/place" -> PlaceOrder
  }

  // L5 Experience
  page Orders route "/orders" {
    list OpenOrders as OrderSummary { reference, status, total } actions Cancel
  }

  page OrderDetail route "/orders/{id}" {
    detail OrderSummary actions PlaceOrder, Cancel
    form Cancel
  }

  navigation Main {
    "Orders" -> Orders
  }

  flow CheckoutFlow for Checkout { Orders -> OrderDetail }

  messages en {
    OrderSummary.total = "Total"
  }
}
