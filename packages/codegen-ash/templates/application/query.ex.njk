{# A query: a read action, described by its `describe` text and annotation, in the `actions` section of its entity's resource with its inputs as arguments, filter, sort and pagination. -#}
read :{{ name }} do
{% block description %}
{% if description %}
  description {{ description }}
{% endif %}
{% endblock %}
{% block arguments %}
{% for a in arguments %}
  argument :{{ a.name }}, {{ a.type }}, allow_nil?: {{ "true" if a.optional else "false" }}
{% endfor %}
{% endblock %}
{% block filter %}
{% if filter %}
  filter expr({{ filter }})
{% endif %}
{% endblock %}
{% block sort %}
{% if sorts.length %}
  prepare build(sort: [{% for s in sorts %}{{ s.field }}: :{{ s.direction }}{{ ", " if not loop.last }}{% endfor %}])
{% endif %}
{% endblock %}
{% block pagination %}
{% if pageSize %}
  pagination offset?: true, default_limit: {{ pageSize }}, required?: false
{% endif %}
{% endblock %}
end
