// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`behavior, queries and the JSON:API are patched into the generated modules 1`] = `
{
  "config/config.exs": "import Config

config :shop, Oban,
  engine: Oban.Engines.Basic,
  queues: [default: 10, order_expire_drafts: 10],
  repo: Shop.Repo
",
  "lib/shop/application.ex": "defmodule Shop.Application do
  def start(_type, _args) do
    children = [
      Shop.Repo
    ]
  end
end
",
  "lib/shop/crm/account.ex": "defmodule Shop.Crm.Account do
  use Ash.Resource, otp_app: :shop, domain: Shop.Crm

  identities do
    identity :unique_name, [:name]
  end
end
",
  "lib/shop/sales.ex": "defmodule Shop.Sales do
  use Ash.Domain,
    otp_app: :shop,
    extensions: [AshJsonApi.Domain]

  resources do
    resource Shop.Sales.Order
  end

  json_api do
    routes do
      base_route "/", Shop.Sales.Order do
        index :open_orders, route: "/orders", default_fields: [:reference, :status, :total]
        patch :place_order, route: "/orders/:id/place"
      end
    end
  end
end
",
  "lib/shop/sales/order.ex": "defmodule Shop.Sales.Order do
  use Ash.Resource, otp_app: :shop, domain: Shop.Sales, data_layer: AshPostgres.DataLayer,
    extensions: [AshJsonApi.Resource, AshOban, AshStateMachine]

  actions do
    defaults [:read, :destroy]

    update :place_order do
      require_atomic? false
      change set_attribute(:placed_at, &DateTime.utc_now/0)
      change transition_state(:placed)
    end

    update :cancel do
      require_atomic? false
      argument :reason, :string, allow_nil?: true
      validate negate(present(:paid_at)), message: "invalid transition"
      change transition_state(:cancelled)
    end

    update :payment_received do
      require_atomic? false
      change transition_state(:paid)
    end

    read :expire_drafts_targets do
      pagination keyset?: true, required?: false
    end

    read :open_orders do
      filter expr(status in [:placed, :paid])
      prepare build(sort: [placed_at: :desc])
      pagination offset?: true, default_limit: 50, required?: false
    end
  end

  attributes do
    attribute :status, Shop.Sales.OrderStatus do
      default :draft
      allow_nil? false
    end
  end

  identities do
    identity :unique_reference, [:reference]
  end

  state_machine do
    initial_states [:draft]
    default_initial_state :draft
    state_attribute :status

    transitions do
      transition :place_order, from: [:draft], to: :placed
      transition :payment_received, from: [:placed], to: :paid
      transition :cancel, from: [:draft, :placed], to: :cancelled
    end
  end

  oban do
    triggers do
      trigger :expire_drafts do
        action :cancel
        read_action :expire_drafts_targets
        queue :order_expire_drafts
        where expr((status == :draft) and (created_at < ago(720, :hour)))
        scheduler_cron "0 3 * * *"
        worker_module_name Shop.Sales.Order.AshOban.Worker.ExpireDrafts
        scheduler_module_name Shop.Sales.Order.AshOban.Scheduler.ExpireDrafts
      end
    end
  end

  calculations do
    calculate :customer_name, :string, expr(customer.name)
  end

  json_api do
    type "order"
  end
end
",
  "lib/shop_web/ash_json_api_router.ex": "defmodule ShopWeb.AshJsonApiRouter do
  use AshJsonApi.Router,
    domains: [Shop.Sales],
    open_api: "/open_api"
end
",
  "lib/shop_web/live/order_detail_live.ex": "defmodule ShopWeb.OrderDetailLive do
  use ShopWeb, :live_view

  @impl true
  def mount(%{"id" => id}, _session, socket) do
    {:ok, socket |> assign(:page_title, "Order detail") |> assign(:id, id) |> load()}
  end

  defp load(socket) do
    socket
    |> assign(:record_1, Ash.get!(Shop.Sales.Order, socket.assigns.id, load: [:customer_name]))
    |> assign(:form_2, AshPhoenix.Form.for_update(Ash.get!(Shop.Sales.Order, socket.assigns.id), :cancel) |> to_form())
  end

  @impl true
  def handle_event("run_place_order", %{"id" => id}, socket) do
    case Ash.update(Ash.get!(Shop.Sales.Order, id), %{}, action: :place_order) do
      {:ok, _} -> {:noreply, socket |> put_flash(:info, "PlaceOrder done.") |> load()}
      {:error, error} -> {:noreply, put_flash(socket, :error, "PlaceOrder failed: " <> Exception.message(error))}
    end
  end

  @impl true
  def handle_event("run_cancel", %{"id" => id}, socket) do
    case Ash.update(Ash.get!(Shop.Sales.Order, id), %{}, action: :cancel) do
      {:ok, _} -> {:noreply, socket |> put_flash(:info, "Cancel done.") |> load()}
      {:error, error} -> {:noreply, put_flash(socket, :error, "Cancel failed: " <> Exception.message(error))}
    end
  end

  @impl true
  def handle_event("submit_cancel", %{"form" => params}, socket) do
    case AshPhoenix.Form.submit(socket.assigns.form_2, params: params) do
      {:ok, _} -> {:noreply, socket |> put_flash(:info, "Cancel done.") |> load()}
      {:error, form} -> {:noreply, assign(socket, :form_2, form)}
    end
  end

  @impl true
  def render(assigns) do
    ~H"""
    <Layouts.app flash={@flash}>
      <nav class="flex gap-4 mb-6"><.link navigate="/orders">Orders</.link></nav>
      <.header>Order detail</.header>
      <.list>
        <:item title="Reference">{to_string(@record_1.reference)}</:item>
        <:item title="Status">{to_string(@record_1.status)}</:item>
        <:item title="Customer name">{to_string(@record_1.customer_name)}</:item>
      </.list>
      <.button phx-click="run_place_order" phx-value-id={@record_1.id}>PlaceOrder</.button> <.button phx-click="run_cancel" phx-value-id={@record_1.id}>Cancel</.button>
      <.form for={@form_2} phx-submit="submit_cancel">
        <.input field={@form_2[:reason]} label="Reason" />
        <.button>Cancel</.button>
      </.form>
    </Layouts.app>
    """
  end
end
",
  "lib/shop_web/live/orders_live.ex": "defmodule ShopWeb.OrdersLive do
  use ShopWeb, :live_view

  @impl true
  def mount(_params, _session, socket) do
    {:ok, socket |> assign(:page_title, "Orders") |> load()}
  end

  defp load(socket) do
    socket
    |> assign(:list_1, Ash.read!(Shop.Sales.Order, action: :open_orders, page: [limit: 50]).results)
  end

  @impl true
  def handle_event("run_cancel", %{"id" => id}, socket) do
    case Ash.update(Ash.get!(Shop.Sales.Order, id), %{}, action: :cancel) do
      {:ok, _} -> {:noreply, socket |> put_flash(:info, "Cancel done.") |> load()}
      {:error, error} -> {:noreply, put_flash(socket, :error, "Cancel failed: " <> Exception.message(error))}
    end
  end

  @impl true
  def render(assigns) do
    ~H"""
    <Layouts.app flash={@flash}>
      <nav class="flex gap-4 mb-6"><.link navigate="/orders">Orders</.link></nav>
      <.header>Orders</.header>
      <.table id="list-1" rows={@list_1}>
        <:col :let={row} label="Reference">{to_string(row.reference)}</:col>
        <:col :let={row} label="Status">{to_string(row.status)}</:col>
        <:action :let={row}><.button phx-click="run_cancel" phx-value-id={row.id}>Cancel</.button></:action>
      </.table>
    </Layouts.app>
    """
  end
end
",
  "lib/shop_web/router.ex": "defmodule ShopWeb.Router do
  use ShopWeb, :router

  scope "/", ShopWeb do
    pipe_through :browser

    get "/", PageController, :home

    live "/orders/:id", OrderDetailLive

    live "/orders", OrdersLive
  end
end
",
  "test/shop/crm/account_test.exs": "defmodule Shop.Crm.AccountTest do
  use ExUnit.Case, async: true

  @tag skip: "registry task: crm.Account.policy[read]"
  test "policy[read] allows permitted actors"

  @tag skip: "registry task: crm.Account.policy[read]"
  test "policy[read] denies other actors"
end
",
  "test/shop/sales/order_test.exs": "defmodule Shop.Sales.OrderTest do
  use ExUnit.Case, async: true

  @tag skip: "registry task: sales.Order.invariant[\\"total never negative\\"]"
  test "invariant total never negative holds for valid records"

  @tag skip: "registry task: sales.Order.invariant[\\"total never negative\\"]"
  test "invariant total never negative rejects violations"

  @tag skip: "registry task: sales.Order.policy[read]"
  test "policy[read] allows permitted actors"

  @tag skip: "registry task: sales.Order.policy[read]"
  test "policy[read] denies other actors"

  @tag skip: "registry task: sales.Order.policy[create,update,delete]"
  test "policy[create,update,delete] allows permitted actors"

  @tag skip: "registry task: sales.Order.policy[create,update,delete]"
  test "policy[create,update,delete] denies other actors"

  @tag skip: "registry task: sales.Order.policy[read fields total]"
  test "policy[read fields total] allows permitted actors"

  @tag skip: "registry task: sales.Order.policy[read fields total]"
  test "policy[read fields total] denies other actors"

  @tag skip: "registry task: sales.PlaceOrder"
  test "action place_order precondition 1 is enforced"

  @tag skip: "registry task: sales.OrderFlow.transition[draft->placed]"
  test "transition draft -> placed moves from allowed states"

  @tag skip: "registry task: sales.OrderFlow.transition[draft->placed]"
  test "transition draft -> placed refuses other states"

  @tag skip: "registry task: sales.OrderFlow.transition[placed->paid]"
  test "transition placed -> paid moves from allowed states"

  @tag skip: "registry task: sales.OrderFlow.transition[placed->paid]"
  test "transition placed -> paid refuses other states"

  @tag skip: "registry task: sales.OrderFlow.transition[draft,placed->cancelled]"
  test "transition draft, placed -> cancelled moves from allowed states"

  @tag skip: "registry task: sales.OrderFlow.transition[draft,placed->cancelled]"
  test "transition draft, placed -> cancelled refuses other states"
end
",
}
`;

