{
  "name": "@appling/codegen",
  "version": "0.1.2",
  "description": "Appling code generation core: plan, step runner, extension contract and task registry",
  "homepage": "https://www.appling.tools/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex20465/appling.git",
    "directory": "packages/codegen"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    },
    "./stacks": {
      "types": "./out/stacks.d.ts",
      "default": "./out/stacks.js"
    }
  },
  "files": [
    "out"
  ],
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@appling/model": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
