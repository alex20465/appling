{
  "name": "@appling/codegen-rust",
  "version": "0.1.1",
  "description": "Appling code generation extension for Rust",
  "homepage": "https://www.appling.tools/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex20465/appling.git",
