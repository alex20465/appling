{# The serde helper for durations in src/lib.rs, when a struct holds one: `chrono::TimeDelta` has none, so a duration is whole nanoseconds, the way Go encodes a `time.Duration`. #}
/// Serde for `chrono::TimeDelta`, which has none: a duration is whole nanoseconds, the way Go encodes a
/// `time.Duration`. Fields use it through `#[serde(with = "crate::serde_duration")]`.
pub mod serde_duration {
    use serde::{Deserialize, Deserializer, Serialize, Serializer};

    fn nanoseconds<E: serde::ser::Error>(value: &chrono::TimeDelta) -> Result<i64, E> {
        value.num_nanoseconds().ok_or_else(|| E::custom("duration out of range of i64 nanoseconds"))
    }

    pub fn serialize<S: Serializer>(value: &chrono::TimeDelta, serializer: S) -> Result<S::Ok, S::Error> {
        nanoseconds::<S::Error>(value)?.serialize(serializer)
    }

    pub fn deserialize<'de, D: Deserializer<'de>>(deserializer: D) -> Result<chrono::TimeDelta, D::Error> {
        i64::deserialize(deserializer).map(chrono::TimeDelta::nanoseconds)
    }

    /// An optional duration, `null` for `None`.
    pub mod option {
        use serde::{Deserialize, Deserializer, Serialize, Serializer};

        pub fn serialize<S: Serializer>(value: &Option<chrono::TimeDelta>, serializer: S) -> Result<S::Ok, S::Error> {
            value.as_ref().map(super::nanoseconds::<S::Error>).transpose()?.serialize(serializer)
        }

        pub fn deserialize<'de, D: Deserializer<'de>>(deserializer: D) -> Result<Option<chrono::TimeDelta>, D::Error> {
            Option::<i64>::deserialize(deserializer).map(|value| value.map(chrono::TimeDelta::nanoseconds))
        }
    }

    /// A list of durations.
    pub mod list {
        use serde::{Deserialize, Deserializer, Serialize, Serializer};

        pub fn serialize<S: Serializer>(value: &[chrono::TimeDelta], serializer: S) -> Result<S::Ok, S::Error> {
            value.iter().map(super::nanoseconds::<S::Error>).collect::<Result<Vec<_>, _>>()?.serialize(serializer)
        }

        pub fn deserialize<'de, D: Deserializer<'de>>(deserializer: D) -> Result<Vec<chrono::TimeDelta>, D::Error> {
            Vec::<i64>::deserialize(deserializer).map(|value| value.into_iter().map(chrono::TimeDelta::nanoseconds).collect())
        }
    }
}
