#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    #[ignore = "registry task: crm.Account.policy[read]"]
    fn account_policy_read() {}
    /// A Lead with the defaults of the model and a sample for every other required field.
    fn valid_lead() -> Lead {
        Lead::new("name-1".to_string())
    }

    #[test]
    fn lead_policy_read_create_update_allows_permitted_actors() {
        let actor = crate::access::Actor::employee();
        let lead = valid_lead();
        assert!(can_read_lead(&actor, &lead), "can_read_lead: want true for crm.Employee");
        assert!(can_create_lead(&actor, &lead), "can_create_lead: want true for crm.Employee");
        assert!(can_update_lead(&actor, &lead), "can_update_lead: want true for crm.Employee");
    }

    #[test]
    fn lead_policy_read_create_update_denies_other_actors() {
        let actor = crate::access::Actor::shopper();
        let lead = valid_lead();
        assert!(!can_read_lead(&actor, &lead), "can_read_lead: want false for sales.Shopper");
        assert!(!can_create_lead(&actor, &lead), "can_create_lead: want false for sales.Shopper");
        assert!(!can_update_lead(&actor, &lead), "can_update_lead: want false for sales.Shopper");
    }
    #[test]
    #[ignore = "registry task: crm.Contact"]
    fn crm_contact() {}
    #[test]
    #[ignore = "registry task: crm.Contact.policy[]"]
    fn contact_policy() {}
    #[test]
    #[ignore = "registry task: crm.Win"]
    fn crm_win() {}
    #[test]
    #[ignore = "registry task: crm.Win.policy[]"]
    fn win_policy() {}
    #[test]
    #[ignore = "registry task: crm.Lose"]
    fn crm_lose() {}
    #[test]
    #[ignore = "registry task: crm.Lose.policy[]"]
    fn lose_policy() {}
    #[test]
    fn lead_flow_transition_prospect_contacted() {
        let actor = crate::access::Actor::employee();
        let mut x = valid_lead();
        x.status = LeadStatus::Prospect;
        contact(&actor, &mut x).expect("contact from prospect");
        assert_eq!(x.status, LeadStatus::Contacted, "contact from prospect goes to contacted");
        let mut x = valid_lead();
        x.status = LeadStatus::Contacted;
        assert!(matches!(contact(&actor, &mut x), Err(Error::InvalidTransition { .. })), "contact refuses contacted");
    }
    #[test]
    fn lead_flow_transition_contacted_won() {
        let actor = crate::access::Actor::employee();
        let mut x = valid_lead();
        x.status = LeadStatus::Contacted;
        win(&actor, &mut x).expect("win from contacted");
        assert_eq!(x.status, LeadStatus::Won, "win from contacted goes to won");
        let mut x = valid_lead();
        x.status = LeadStatus::Prospect;
        assert!(matches!(win(&actor, &mut x), Err(Error::InvalidTransition { .. })), "win refuses prospect");
    }
    #[test]
    fn lead_flow_transition_prospect_contacted_lost() {
        let actor = crate::access::Actor::employee();
        let mut x = valid_lead();
        x.status = LeadStatus::Prospect;
        lose(&actor, &mut x).expect("lose from prospect");
        assert_eq!(x.status, LeadStatus::Lost, "lose from prospect goes to lost");
        let mut x = valid_lead();
        x.status = LeadStatus::Won;
        assert!(matches!(lose(&actor, &mut x), Err(Error::InvalidTransition { .. })), "lose refuses won");
    }
    #[test]
    #[ignore = "registry task: crm.FollowUp.policy[]"]
    fn follow_up_policy() {}
    #[test]
    #[ignore = "registry task: crm.Convert.policy[]"]
    fn convert_policy() {}
}
