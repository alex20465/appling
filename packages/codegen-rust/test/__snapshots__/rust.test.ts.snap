    pub email: String,
}

impl Account {
    /// A new Account with the defaults of the model; the arguments are the fields without one.
    pub fn new(name: String, email: String) -> Self {
        Self {
            id: 0,
            name,
            email,
        }
    }

    /// Checks the invariants of Account and returns the labels of those that do not hold.
    pub fn validate(&self) -> Result<(), Vec<&'static str>> {
        let errors = Vec::new();
        if errors.is_empty() { Ok(()) } else { Err(errors) }
    }
}

impl crate::access::Tenanted for Account {
    /// The id of the crm.Account this Account belongs to, for the tenant crm.Company.
    fn tenant_id(&self) -> Option<i64> {
        Some(self.id)
    }
}

/// Whether the policies of crm.Account let the actor read the record.
pub fn can_read_account(actor: &crate::access::Actor, account: &Account) -> bool {
    crate::access::in_tenant(actor, account) && account_policy_read(actor, account)
}

/// Whether the policies of crm.Account let the actor create the record; no policy grants create.
pub fn can_create_account(_actor: &crate::access::Actor, _account: &Account) -> bool {
    false
}

/// Whether the policies of crm.Account let the actor update the record; no policy grants update.
pub fn can_update_account(_actor: &crate::access::Actor, _account: &Account) -> bool {
    false
}

/// Whether the policies of crm.Account let the actor delete the record; no policy grants delete.
pub fn can_delete_account(_actor: &crate::access::Actor, _account: &Account) -> bool {
    false
}

/// The policy crm.Account.policy[read]: actor.is(Clerk) || (actor.is(sales.Customer) && actor.account == this)
fn account_policy_read(actor: &crate::access::Actor, account: &Account) -> bool {
    crate::access::is_clerk(actor) || (crate::access::is_customer(actor) && (actor.account == Some(account.id)))
}

