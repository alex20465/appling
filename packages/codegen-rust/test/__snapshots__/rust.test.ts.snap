  "src/access.rs": "//! The actors, roles and tenant of the model and the checks its policies call.

/// A role of the model.
#[derive(Debug, Clone, Copy, PartialEq, Eq, serde::Serialize, serde::Deserialize)]
pub enum Role {
    /// The role crm.Clerk.
    #[serde(rename = "crm.Clerk")]
    Clerk,
    /// The role sales.Customer.
    #[serde(rename = "sales.Customer")]
    Customer,
}

/// A declared actor of the model.
#[derive(Debug, Clone, Copy, PartialEq, Eq, serde::Serialize, serde::Deserialize)]
pub enum ActorType {
    /// The human actor crm.Employee.
    #[serde(rename = "crm.Employee")]
    Employee,
    /// The human actor sales.Shopper.
    #[serde(rename = "sales.Shopper")]
    Shopper,
}

/// Who acts: a declared actor with the roles it carries, the tenant it acts in, and the fields the actors
/// declare. A field is \`None\` for actors that do not declare it; fields that hold records hold their id.
#[derive(Debug, Clone, PartialEq, serde::Serialize, serde::Deserialize)]
pub struct Actor {
    #[serde(rename = "type")]
    pub actor_type: ActorType,
    pub roles: Vec<Role>,
    /// The record the actor is stored as, for actors declared with \`is\`.
    pub id: Option<i64>,
    /// The id of the crm.Account the actor acts in (the tenant crm.Company); \`None\` when it acts across tenants.
    pub tenant: Option<i64>,
    /// The field account of sales.Shopper, the id of a crm.Account.
    pub account: Option<i64>,
}

impl Actor {
    /// The actor crm.Employee with the roles it declares.
    pub fn employee() -> Self {
        Self {
            actor_type: ActorType::Employee,
            roles: vec![Role::Clerk],
            id: None,
            tenant: None,
            account: None,
        }
    }

    /// The actor sales.Shopper with the roles it declares.
    pub fn shopper() -> Self {
        Self {
            actor_type: ActorType::Shopper,
            roles: vec![Role::Customer],
            id: None,
            tenant: None,
            account: None,
        }
    }

    /// Whether the actor carries the role, without checking the role's condition.
    pub fn has(&self, role: Role) -> bool {
        self.roles.contains(&role)
    }
}

/// Whether the actor is crm.Clerk: it carries the role.
pub fn is_clerk(actor: &Actor) -> bool {
    actor.has(Role::Clerk)
}

/// Whether the actor is sales.Customer: it carries the role.
pub fn is_customer(actor: &Actor) -> bool {
    actor.has(Role::Customer)
}

/// A record that belongs to a crm.Account, the entity of the tenant crm.Company.
pub trait Tenanted {
    /// The id of the crm.Account, \`None\` when the record does not reach one.
    fn tenant_id(&self) -> Option<i64>;
}

/// Whether the record belongs to the tenant the actor acts in. An actor without a tenant acts across tenants.
pub fn in_tenant(actor: &Actor, record: &impl Tenanted) -> bool {
    actor.tenant.is_none() || record.tenant_id() == actor.tenant
}
