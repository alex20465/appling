    pub name: String,
    pub email: String,
}

impl Account {
    /// A new Account with the defaults of the model; the arguments are the fields without one.
    pub fn new(name: String, email: String) -> Self {
        Self {
            id: 0,
            name,
            email,
        }
    }

    /// Checks the invariants of Account and returns the labels of those that do not hold.
    pub fn validate(&self) -> Result<(), Vec<&'static str>> {
        let errors = Vec::new();
        if errors.is_empty() { Ok(()) } else { Err(errors) }
    }
}

