  "src/sales.rs": "//! The module sales of the model.

/// The errors of this module's actions.
#[derive(Debug, Clone, PartialEq)]
pub enum Error {
    InvalidTransition { action: &'static str, from: String },
    Forbidden { action: &'static str },
    EmptyOrder,
    Declined,
}

impl std::fmt::Display for Error {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{self:?}")
    }
}

impl std::error::Error for Error {}

/// The events this module's actions emit.
#[derive(Debug, Clone, PartialEq)]
pub enum Event {
    OrderPlaced(OrderPlaced),
    PaymentReceived(PaymentReceived),
}

/// The enum sales.OrderStatus.
#[derive(Debug, Clone, Copy, PartialEq, Eq, serde::Serialize, serde::Deserialize)]
pub enum OrderStatus {
    #[serde(rename = "draft")]
    Draft,
    #[serde(rename = "placed")]
    Placed,
    #[serde(rename = "paid")]
    Paid,
    #[serde(rename = "cancelled")]
    Cancelled,
}

/// The value type sales.Line.
#[derive(Debug, Clone, PartialEq, serde::Serialize, serde::Deserialize)]
pub struct Line {
    pub product: String,
    pub quantity: i64,
    pub amount: rust_decimal::Decimal,
}

/// The entity sales.Order.
#[derive(Debug, Clone, PartialEq, serde::Serialize, serde::Deserialize)]
pub struct Order {
    pub id: i64,
    pub reference: String,
    pub customer: Box<crate::crm::Account>,
    pub lines: Vec<Line>,
    pub status: OrderStatus,
    pub created_at: chrono::DateTime<chrono::Utc>,
    pub placed_at: Option<chrono::DateTime<chrono::Utc>>,
    pub paid_at: Option<chrono::DateTime<chrono::Utc>>,
}

impl Order {
    /// A new Order with the defaults of the model; the arguments are the fields without one.
    pub fn new(reference: String, customer: Box<crate::crm::Account>, created_at: chrono::DateTime<chrono::Utc>) -> Self {
        Self {
            id: 0,
            reference,
            customer,
            lines: Vec::new(),
            status: OrderStatus::Draft,
            created_at,
            placed_at: None,
            paid_at: None,
        }
    }

    /// The derived field sales.Order.total.
    pub fn total(&self) -> rust_decimal::Decimal {
        self.lines.iter().map(|l| l.amount).sum::<rust_decimal::Decimal>()
    }

    /// Checks the invariants of Order and returns the labels of those that do not hold.
    pub fn validate(&self) -> Result<(), Vec<&'static str>> {
        let mut errors = Vec::new();
        if !(self.total() >= rust_decimal::Decimal::from(0)) {
            errors.push("total never negative");
        }
        if errors.is_empty() { Ok(()) } else { Err(errors) }
    }
}

impl crate::access::Tenanted for Order {
    /// The id of the crm.Account this Order belongs to, for the tenant crm.Company.
    fn tenant_id(&self) -> Option<i64> {
        Some(self.customer.id)
    }
}

/// Whether the policies of sales.Order let the actor read the record.
pub fn can_read_order(actor: &crate::access::Actor, order: &Order) -> bool {
    crate::access::in_tenant(actor, order) && order_policy_read(actor, order)
}

/// Whether the actor may read the field total of the record.
pub fn can_read_order_total(actor: &crate::access::Actor, order: &Order) -> bool {
    can_read_order(actor, order) && order_policy_read_fields_total(actor, order)
}

/// Whether the policies of sales.Order let the actor create the record.
pub fn can_create_order(actor: &crate::access::Actor, order: &Order) -> bool {
    crate::access::in_tenant(actor, order) && order_policy_create_delete(actor, order)
}

/// Whether the policies of sales.Order let the actor update the record.
pub fn can_update_order(actor: &crate::access::Actor, order: &Order) -> bool {
    crate::access::in_tenant(actor, order) && order_policy_update(actor, order)
}

/// Whether the policies of sales.Order let the actor delete the record.
pub fn can_delete_order(actor: &crate::access::Actor, order: &Order) -> bool {
    crate::access::in_tenant(actor, order) && order_policy_create_delete(actor, order)
}

/// The policy sales.Order.policy[read]: actor.is(crm.Clerk) || (actor.is(Customer) && customer == actor.account)
fn order_policy_read(actor: &crate::access::Actor, order: &Order) -> bool {
    crate::access::is_clerk(actor) || (crate::access::is_customer(actor) && (actor.account == Some(order.customer.id)))
}

/// The policy sales.Order.policy[create,delete]: actor.is(crm.Clerk)
fn order_policy_create_delete(actor: &crate::access::Actor, _order: &Order) -> bool {
    crate::access::is_clerk(actor)
}

/// The policy sales.Order.policy[update]: actor.is(crm.Clerk) || (actor.is(Customer) && customer == actor.account && status == draft)
fn order_policy_update(actor: &crate::access::Actor, order: &Order) -> bool {
    crate::access::is_clerk(actor) || ((crate::access::is_customer(actor) && (actor.account == Some(order.customer.id))) && (order.status == OrderStatus::Draft))
}

/// The policy sales.Order.policy[read fields total]: actor.is(crm.Clerk) || (actor.is(Customer) && status != draft)
fn order_policy_read_fields_total(actor: &crate::access::Actor, order: &Order) -> bool {
    crate::access::is_clerk(actor) || (crate::access::is_customer(actor) && (order.status != OrderStatus::Draft))
}

/// The event sales.OrderPlaced.
#[derive(Debug, Clone, PartialEq, serde::Serialize, serde::Deserialize)]
pub struct OrderPlaced {
    pub order: Box<Order>,
}

/// The event sales.PaymentReceived.
#[derive(Debug, Clone, PartialEq, serde::Serialize, serde::Deserialize)]
pub struct PaymentReceived {
    pub order: Box<Order>,
}

/// The action sales.PlaceOrder. It returns the events it emits.
pub fn place_order(actor: &crate::access::Actor, order: &mut Order) -> Result<Vec<Event>, Error> {
    let mut events = Vec::new();
    if !can_place_order(actor, order) {
        return Err(Error::Forbidden { action: "PlaceOrder" });
    }
    if !((order.lines.len() as i64) > 0) {
        return Err(Error::EmptyOrder);
    }
    match order.status {
        OrderStatus::Draft => {
            events.push(Event::OrderPlaced(OrderPlaced { order: Box::new(order.clone()) }));
            order.status = OrderStatus::Placed;
        }
        _ => return Err(Error::InvalidTransition { action: "PlaceOrder", from: format!("{:?}", order.status) }),
    }
    order.placed_at = Some(chrono::Utc::now());
    Ok(events)
}

/// Whether the actor may run sales.PlaceOrder, including the update check of sales.Order.
pub fn can_place_order(actor: &crate::access::Actor, order: &Order) -> bool {
    can_update_order(actor, order) && place_order_policy(actor, order)
}

/// The policy sales.PlaceOrder.policy[]: actor.is(Customer) && customer == actor.account
fn place_order_policy(actor: &crate::access::Actor, order: &Order) -> bool {
    crate::access::is_customer(actor) && (actor.account == Some(order.customer.id))
}

/// The action sales.Cancel. It returns the events it emits.
pub fn cancel(actor: &crate::access::Actor, order: &mut Order, reason: Option<String>) -> Result<Vec<Event>, Error> {
    let events = Vec::new();
    if !can_cancel(actor, order, reason.clone()) {
        return Err(Error::Forbidden { action: "Cancel" });
    }
    match order.status {
        OrderStatus::Draft | OrderStatus::Placed if !order.paid_at.is_some() => {
            order.status = OrderStatus::Cancelled;
        }
        _ => return Err(Error::InvalidTransition { action: "Cancel", from: format!("{:?}", order.status) }),
    }
    Ok(events)
}

/// Whether the actor may run sales.Cancel, including the update check of sales.Order.
pub fn can_cancel(actor: &crate::access::Actor, order: &Order, reason: Option<String>) -> bool {
    can_update_order(actor, order) && cancel_policy(actor, order, reason.clone())
}

/// The policy sales.Cancel.policy[]: actor.is(crm.Clerk)
fn cancel_policy(actor: &crate::access::Actor, _order: &Order, _reason: Option<String>) -> bool {
    crate::access::is_clerk(actor)
}

/// Applies the transitions of sales.OrderFlow that PaymentReceived triggers.
pub fn order_flow_on_payment_received(event: &mut PaymentReceived) -> Result<Vec<Event>, Error> {
    let order = &mut event.order;
    let events = Vec::new();
    match order.status {
        OrderStatus::Placed => {
            order.status = OrderStatus::Paid;
        }
        _ => return Err(Error::InvalidTransition { action: "PaymentReceived", from: format!("{:?}", order.status) }),
    }
    Ok(events)
}

#[cfg(test)]
mod tests {
    #[test]
    #[ignore = "registry task: sales.Order.invariant[\\"total never negative\\"]"]
    fn order_total_never_negative() {}
    #[test]
    #[ignore = "registry task: sales.Order.policy[read]"]
    fn order_policy_read() {}
    #[test]
    #[ignore = "registry task: sales.Order.policy[create,delete]"]
    fn order_policy_create_delete() {}
    #[test]
    #[ignore = "registry task: sales.Order.policy[update]"]
    fn order_policy_update() {}
    #[test]
    #[ignore = "registry task: sales.Order.policy[read fields total]"]
    fn order_policy_read_fields_total() {}
    #[test]
    #[ignore = "registry task: sales.PlaceOrder"]
    fn sales_place_order() {}
    #[test]
    #[ignore = "registry task: sales.PlaceOrder.policy[]"]
    fn place_order_policy() {}
    #[test]
    #[ignore = "registry task: sales.Cancel"]
    fn sales_cancel() {}
    #[test]
    #[ignore = "registry task: sales.Cancel.policy[]"]
