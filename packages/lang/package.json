{
  "name": "@appling/lang",
  "version": "0.2.2",
  "description": "Appling language: grammar, scoping, validation, expression typing, canonical printer and language server",
  "homepage": "https://www.appling.tools/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex20465/appling.git",
    "directory": "packages/lang"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    },
    "./lsp": {
      "types": "./out/lsp.d.ts",
      "default": "./out/lsp.js"
    },
    "./monarch": {
      "types": "./out/syntaxes/monarch.d.ts",
      "default": "./out/syntaxes/monarch.js"
    }
  },
  "files": [
    "out",
    "src/appling.langium",
    "src/syntaxes/appling.tmLanguage.json"
  ],
  "scripts": {
    "build": "langium generate && tsc"
  },
  "dependencies": {
    "langium": "4.4.0",
    "vscode-languageserver": "~10.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "langium-cli": "4.4.0",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "appling-language-server": "./out/language-server.js"
  }
}
