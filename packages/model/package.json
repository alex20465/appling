{
  "name": "@appling/model",
  "version": "0.1.5",
  "description": "Appling semantic graph: nodes, edges and module dependencies of a resolved model",
  "homepage": "https://www.appling.tools/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex20465/appling.git",
    "directory": "packages/model"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    },
    "./graph": {
      "types": "./out/graph.d.ts",
      "default": "./out/graph.js"
    },
    "./edit": {
      "types": "./out/edit.d.ts",
      "default": "./out/edit.js"
    },
    "./simulator": {
      "types": "./out/simulator.d.ts",
      "default": "./out/simulator.js"
    },
    "./relevance": {
      "types": "./out/relevance.d.ts",
      "default": "./out/relevance.js"
    },
    "./diff": {
      "types": "./out/diff.d.ts",
      "default": "./out/diff.js"
    },
    "./anchors": {
      "types": "./out/anchors.d.ts",
      "default": "./out/anchors.js"
    },
    "./implementation": {
      "types": "./out/implementation.d.ts",
      "default": "./out/implementation.js"
    }
  },
  "files": [
    "out"
  ],
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@appling/lang": "workspace:*",
    "langium": "4.4.0",
    "tree-sitter-elixir": "0.3.5",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-rust": "0.24.0",
    "tree-sitter-typescript": "0.23.2",
    "web-tree-sitter": "0.27.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
