{
  "name": "@appling/model",
  "version": "0.1.1",
  "description": "Appling semantic graph: nodes, edges and module dependencies of a resolved model",
  "type": "module",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    },
    "./graph": {
      "types": "./out/graph.d.ts",
      "default": "./out/graph.js"
    },
    "./edit": {
      "types": "./out/edit.d.ts",
      "default": "./out/edit.js"
    },
    "./simulator": {
      "types": "./out/simulator.d.ts",
      "default": "./out/simulator.js"
    },
    "./relevance": {
      "types": "./out/relevance.d.ts",
      "default": "./out/relevance.js"
    }
  },
  "files": [
    "out"
  ],
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@appling/lang": "workspace:*",
    "langium": "4.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
