{
  "name": "appling-vscode",
  "displayName": "Appling",
  "description": "Appling for VS Code: language support, the read only model inspector in a tab per project, implementation marks and agent sessions",
  "version": "0.1.0",
  "publisher": "techthos",
  "private": true,
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Visualization"
  ],
  "main": "./out/extension/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.appling",
    "workspaceContains:**/appling.config.json",
    "onLanguage:appling"
  ],
  "contributes": {
    "languages": [
      {
        "id": "appling",
        "aliases": [
          "Appling"
        ],
        "extensions": [
          ".appling"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "appling.openCode",
        "title": "Appling: Open the code of this element",
        "enablement": "appling.projects > 0"
      },
      {
        "command": "appling.openInspect",
        "title": "Appling: Open the inspector",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "appling.showInInspect",
        "title": "Appling: Show in the inspector",
        "icon": {
          "light": "out/appling-icon.svg",
          "dark": "out/appling-icon.svg"
        }
      },
      {
        "command": "appling.init",
        "title": "Appling: Initialize Appling in this project",
        "icon": "$(gear)"
      },
      {
        "command": "appling.refresh",
        "title": "Appling: Find the projects again",
        "icon": "$(refresh)"
      },
      {
        "command": "appling.agents.new",
        "title": "Appling: New agent session",
        "icon": "$(add)"
      },
      {
        "command": "appling.agents.focus",
        "title": "Show the terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "appling.agents.answer",
        "title": "Answer",
        "icon": "$(comment)"
      },
      {
        "command": "appling.agents.end",
        "title": "End the session",
        "icon": "$(close)"
      },
      {
        "command": "appling.panel.run",
        "title": "Appling: Open"
      },
      {
        "command": "appling.panel.diff",
        "title": "Text diff",
        "icon": "$(diff)"
      },
      {
        "command": "appling.inspector.openSource",
        "title": "Appling: Open source",
        "icon": "$(go-to-file)"
      },
      {
        "command": "appling.inspector.openCode",
        "title": "Appling: Open code",
        "icon": "$(code)"
      },
      {
        "command": "appling.review.compare",
        "title": "Appling: Compare with\u2026",
        "icon": "$(git-compare)"
      },
      {
        "command": "appling.review.mark",
        "title": "Appling: Mark on the canvas",
        "icon": "$(eye-closed)"
      },
      {
        "command": "appling.review.unmark",
        "title": "Appling: Stop marking on the canvas",
        "icon": "$(eye)"
      }
    ],
    "grammars": [
      {
        "language": "appling",
        "scopeName": "source.appling",
        "path": "./out/appling.tmLanguage.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "appling",
          "title": "Appling",
          "icon": "out/appling-icon.svg"
        }
      ]
    },
    "views": {
      "appling": [
        {
          "id": "appling.projects",
          "name": "Projects"
        },
        {
          "id": "appling.agents",
          "name": "Agent Sessions",
          "when": "appling.projects > 0"
        },
        {
          "id": "appling.inspector",
          "name": "Inspector",
          "when": "appling.inspect"
        },
        {
          "id": "appling.changes",
          "name": "Changes",
          "when": "appling.inspect"
        },
        {
          "id": "appling.review",
          "name": "Review",
          "when": "appling.inspect"
        },
        {
          "id": "appling.code",
          "name": "Code",
          "when": "appling.inspect"
        },
        {
          "when": "appling.inspect",
          "id": "appling.tasks",
          "name": "Tasks"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "appling.projects",
        "contents": "There is no Appling model in this workspace yet.\n[Initialize Appling](command:appling.init)\nIt runs appling init in a terminal: a starter module, appling.config.json with the stack you pick, and the coding agents you connect.",
        "when": "workspaceFolderCount > 0"
      },
      {
        "view": "appling.projects",
        "contents": "Open a folder to model an application with Appling.\n[Open Folder](command:workbench.action.files.openFolder)",
        "when": "workspaceFolderCount == 0"
      },
      {
        "view": "appling.agents",
        "contents": "Agent sessions you start from the command palette (Appling: New agent session) show here, with their status and questions. Agents you start yourself connect through the Appling MCP server that appling init sets up.\n[Initialize Appling](command:appling.init)"
      },
      {
        "view": "appling.changes",
        "contents": "No changed model files. Every change to the model since the last commit, by an agent session or anything else that writes the files, is listed here and marked on the canvas."
      },
      {
        "view": "appling.inspector",
        "contents": "Select an element on the canvas to inspect it. Go to Symbol in Workspace (Ctrl+T) finds any element of the model."
      },
      {
        "view": "appling.tasks",
        "contents": "No open registry tasks. The registry lists what generated code still misses, for your coding agent to finish, once `appling generate` created the application."
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "appling.showInInspect",
          "when": "resourceLangId == appling",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "appling.refresh",
          "when": "view == appling.projects",
          "group": "navigation"
        },
        {
          "command": "appling.inspector.openSource",
          "when": "view == appling.inspector && appling.inspector.element",
          "group": "navigation@1"
        },
        {
          "command": "appling.inspector.openCode",
          "when": "view == appling.inspector && appling.inspector.code",
          "group": "navigation@2"
        },
        {
          "command": "appling.review.compare",
          "when": "view == appling.review",
          "group": "navigation@1"
        },
        {
          "command": "appling.review.mark",
          "when": "view == appling.review && !appling.review.marked",
          "group": "navigation@2"
        },
        {
          "command": "appling.review.unmark",
          "when": "view == appling.review && appling.review.marked",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "appling.agents.answer",
          "when": "view == appling.agents && viewItem == agent-waiting",
          "group": "inline"
        },
        {
          "command": "appling.agents.end",
          "when": "view == appling.agents && viewItem =~ /^agent/",
          "group": "inline"
        },
        {
          "command": "appling.panel.diff",
          "when": "view =~ /^appling\\.(inspector|changes|review|code|tasks)$/ && viewItem =~ /\\bdiff\\b/",
          "group": "inline"
        },
        {
          "command": "appling.init",
          "when": "view == appling.projects && viewItem =~ /\\bnew\\b/",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "appling.agents.focus",
          "when": "false"
        },
        {
          "command": "appling.agents.answer",
          "when": "false"
        },
        {
          "command": "appling.agents.end",
          "when": "false"
        },
        {
          "command": "appling.panel.run",
          "when": "false"
        },
        {
          "command": "appling.panel.diff",
          "when": "false"
        },
        {
          "command": "appling.inspector.openSource",
          "when": "false"
        },
        {
          "command": "appling.inspector.openCode",
          "when": "false"
        },
        {
          "command": "appling.review.compare",
          "when": "false"
        },
        {
          "command": "appling.review.mark",
          "when": "false"
        },
        {
          "command": "appling.review.unmark",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Appling",
      "properties": {
        "appling.agents.presets": {
          "type": "array",
          "default": [],
          "markdownDescription": "More agents for **New agent session**: each needs `name` and `command`; `args`, `env`, `wiring` (`claude`, `codex`, `gemini`, `opencode` or `env`, the default) and `answers` are optional. A preset with a built in one's name replaces it.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "command"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "wiring": {
                "enum": [
                  "claude",
                  "codex",
                  "gemini",
                  "opencode",
                  "env"
                ]
              },
              "answers": {
                "type": "object",
                "properties": {
                  "allow": {
                    "type": "string"
                  },
                  "deny": {
                    "type": "string"
                  },
                  "option": {
                    "type": "string"
                  },
                  "submit": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/bundle.mjs && vsce package --no-dependencies --out out/appling.vsix",
    "package": "vsce package --no-dependencies --out out/appling.vsix",
    "host:link": "node scripts/link.mjs",
    "host:unlink": "node scripts/link.mjs --remove"
  },
  "devDependencies": {
    "@appling/ai": "workspace:*",
    "@appling/cli": "workspace:*",
    "@appling/codegen": "workspace:*",
    "@appling/inspect": "workspace:*",
    "@appling/lang": "workspace:*",
    "@appling/model": "workspace:*",
    "@appling/pty-host": "workspace:*",
    "@appling/viz": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vscode-languageclient": "10.1.2"
  }
}
