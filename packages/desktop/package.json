{
  "name": "@appling/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Appling Desktop: one native app for many repos, with the model canvas as the main area of each",
  "homepage": "https://www.appling.tools/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex20465/appling.git",
    "directory": "packages/desktop"
  },
  "type": "module",
  "main": "./out/main.js",
  "bin": {
    "appling-desktop": "./out/bin.js"
  },
  "files": [
    "out"
  ],
  "scripts": {
    "build": "tsc && cp src/shell/index.html src/shell/shell.css src/shell/agents.css out/shell/ && cp ../landing/public/icon-192.png out/tray-icon.png && node build-terminal.mjs && cp ../ai/out/agents/hook.cjs out/agents/hook.cjs",
    "bundle": "node scripts/bundle.mjs",
    "package": "node scripts/bundle.mjs && electron-builder --config electron-builder.config.mjs --publish never"
  },
  "dependencies": {
    "@appling/ai": "workspace:*",
    "@appling/cli": "workspace:*",
    "@appling/ide": "workspace:*",
    "@appling/lang": "workspace:*",
    "@appling/pty-host": "workspace:*",
    "appling-vscode": "workspace:*",
    "electron": "44.9.1",
    "electron-updater": "6.8.11",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "^24.19.2",
    "@types/ws": "8.18.2",
    "@xterm/addon-clipboard": "0.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-image": "0.9.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
