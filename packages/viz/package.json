{
  "name": "@appling/viz",
  "version": "0.1.0",
  "description": "Appling visualization: the model views and canvases shared by the IDE and a floating window for AI sessions",
  "type": "module",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    },
    "./views": {
      "types": "./out/views.d.ts",
      "default": "./out/views.js"
    },
    "./canvas": {
      "types": "./out/canvas/index.d.ts",
      "default": "./out/canvas/index.js"
    },
    "./canvas.css": "./out/canvas/canvas.css"
  },
  "files": [
    "out",
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.window.json && cp src/canvas/canvas.css out/canvas/ && vite build"
  },
  "dependencies": {
    "@appling/model": "workspace:*",
    "electron": "44.7.0",
    "ws": "8.22.0"
  },
  "peerDependencies": {
    "react": "19.3.1"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "devDependencies": {
    "@appling/lang": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
