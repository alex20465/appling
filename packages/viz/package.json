{
  "name": "@appling/viz",
  "version": "0.1.1",
  "description": "Appling visualization: the model views and SVG canvases of the Appling Desktop repo view, and the messages of the visual tools",
  "homepage": "https://www.appling.tools/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex20465/appling.git",
    "directory": "packages/viz"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    },
    "./views": {
      "types": "./out/views.d.ts",
      "default": "./out/views.js"
    },
    "./protocol": {
      "types": "./out/protocol.d.ts",
      "default": "./out/protocol.js"
    },
    "./canvas": {
      "types": "./out/canvas/index.d.ts",
      "default": "./out/canvas/index.js"
    },
    "./canvas.css": "./out/canvas/canvas.css"
  },
  "files": [
    "out"
  ],
  "scripts": {
    "build": "tsc && cp src/canvas/canvas.css out/canvas/"
  },
  "dependencies": {
    "@appling/lang": "workspace:*",
    "@appling/model": "workspace:*"
  },
  "peerDependencies": {
    "react": "19.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@appling/lang": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
