{% endif %}
{{ pad }}{{ record }} := {{ constructor }}()
{% for field in fields %}
{{ pad }}{{ record }}.{{ field.name }} = {{ field.value }}
{% endfor %}
{% if check %}
{{ go.denied(pad, check, action, forbidden) -}}
{% endif %}
{{ pad }}if err := create{{ entity }}({{ record }}); err != nil {
{{ pad }}	return nil, err
