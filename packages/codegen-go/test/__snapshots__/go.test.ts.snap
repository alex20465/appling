// validOrder returns an Order with the defaults of the model and a sample value for every other required field.
func validOrder() *Order {
	x := NewOrder()
	x.Reference = "reference-1"
	x.CreatedAt = time.Now()
	return x
}

func TestOrderTotalNeverNegative(t *testing.T) {
	t.Run("holds for a valid record", func(t *testing.T) {
		if err := validOrder().Validate(); err != nil {
			t.Fatalf("a valid Order: %v", err)
		}
	})
	t.Run("rejects a violation", func(t *testing.T) {
		t.Skip("registry task: sales.Order.invariant[\\"total never negative\\"]")
	})
}

func TestOrderPolicyRead(t *testing.T) {
	t.Skip("registry task: sales.Order.policy[read]")
}

func TestOrderPolicyCreateDelete(t *testing.T) {
	t.Run("allows permitted actors", func(t *testing.T) {
		actor := access.NewEmployee()
		order := validOrder()
		if !CanCreateOrder(actor, order) {
			t.Error("CanCreateOrder: want true for crm.Employee")
		}
		if !CanDeleteOrder(actor, order) {
			t.Error("CanDeleteOrder: want true for crm.Employee")
		}
	})
	t.Run("denies other actors", func(t *testing.T) {
		actor := access.NewShopper()
		order := validOrder()
		if CanCreateOrder(actor, order) {
			t.Error("CanCreateOrder: want false for sales.Shopper")
		}
		if CanDeleteOrder(actor, order) {
			t.Error("CanDeleteOrder: want false for sales.Shopper")
		}
	})
}

func TestOrderPolicyUpdate(t *testing.T) {
	t.Skip("registry task: sales.Order.policy[update]")
}

func TestOrderPolicyReadFieldsTotal(t *testing.T) {
	t.Skip("registry task: sales.Order.policy[read fields total]")
}

func TestPlaceOrderPolicy(t *testing.T) {
	t.Skip("registry task: sales.PlaceOrder.policy[]")
}

func TestCancelPolicy(t *testing.T) {
	t.Skip("registry task: sales.Cancel.policy[]")
}

func TestOrderFlowTransitionPlacedPaid(t *testing.T) {
	t.Skip("registry task: sales.OrderFlow.transition[placed->paid]")
}
