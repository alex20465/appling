  "internal/crm/policies.go": "package crm

import (
	"shop/internal/access"
)


// CanReadAccount reports whether the policies of crm.Account let the actor read the record.
func CanReadAccount(actor access.Actor, account *Account) bool {
	return access.InTenant(actor, account) && accountPolicyRead(actor, account)
}

// CanCreateAccount reports whether the policies of crm.Account let the actor create the record; no policy grants create.
func CanCreateAccount(actor access.Actor, account *Account) bool {
	return false
}

// CanUpdateAccount reports whether the policies of crm.Account let the actor update the record; no policy grants update.
func CanUpdateAccount(actor access.Actor, account *Account) bool {
	return false
}

// CanDeleteAccount reports whether the policies of crm.Account let the actor delete the record; no policy grants delete.
func CanDeleteAccount(actor access.Actor, account *Account) bool {
	return false
}

// accountPolicyRead is the policy crm.Account.policy[read]: actor.is(Clerk) || (actor.is(sales.Customer) && actor.account == this)
func accountPolicyRead(actor access.Actor, account *Account) bool {
	return access.IsClerk(actor) || (access.IsCustomer(actor) && access.Same(actor.Account, account.ID))
}
