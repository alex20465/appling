  "internal/sales/support.go": "package sales


// ptr returns a pointer to a copy of v, for optional fields.
func ptr[T any](v T) *T { return &v }
",
  "internal/sales/types.go": "package sales

import (
	"errors"
	"shop/internal/crm"
	"time"
	"github.com/shopspring/decimal"
)


// OrderStatus is the enum sales.OrderStatus.
type OrderStatus string

const (
	OrderStatusDraft OrderStatus = "draft"
	OrderStatusPlaced OrderStatus = "placed"
	OrderStatusPaid OrderStatus = "paid"
	OrderStatusCancelled OrderStatus = "cancelled"
)

// Line is the value type sales.Line.
type Line struct {
	Product string \`json:"product"\`
	Quantity int64 \`json:"quantity"\`
	Amount decimal.Decimal \`json:"amount"\`
}

// Order is the entity sales.Order.
type Order struct {
	ID int64 \`json:"id"\`
	Reference string \`json:"reference"\`
	Customer *crm.Account \`json:"customer"\`
	Lines []Line \`json:"lines"\`
	Status OrderStatus \`json:"status"\`
	CreatedAt time.Time \`json:"created_at"\`
	PlacedAt *time.Time \`json:"placed_at"\`
	PaidAt *time.Time \`json:"paid_at"\`
}

// NewOrder returns a new Order with the defaults of the model.
func NewOrder() *Order {
	return &Order{
		Status: OrderStatusDraft,
	}
}

// Total is the derived field sales.Order.total.
func (o *Order) Total() decimal.Decimal {
	return func() decimal.Decimal { total := decimal.Zero; for _, l := range o.Lines { total = total.Add(l.Amount) }; return total }()
}

// Validate checks the invariants of Order.
func (o *Order) Validate() error {
	var errs []error
	if !(o.Total().GreaterThanOrEqual(decimal.NewFromInt(0))) {
		errs = append(errs, errors.New("total never negative"))
	}
	return errors.Join(errs...)
}

// TenantID returns the ID of the crm.Account this Order belongs to, for the tenant crm.Company.
func (o *Order) TenantID() (int64, bool) {
	if o.Customer == nil {
		return 0, false
	}
	return o.Customer.ID, true
}
",
  "internal/storage/migrations/00001_appling_initial.sql": "-- +goose Up
-- crm.Account
CREATE TABLE "crm_account" (
	"id" bigserial PRIMARY KEY,
	"name" text NOT NULL UNIQUE,
	"email" text NOT NULL
);

-- sales.Order
CREATE TABLE "sales_order" (
	"id" bigserial PRIMARY KEY,
	"reference" text NOT NULL UNIQUE,
	"customer_id" bigint NOT NULL,
	"lines" jsonb,
	"status" text NOT NULL,
	"created_at" timestamptz NOT NULL,
	"placed_at" timestamptz,
	"paid_at" timestamptz
);

-- appling: foreign keys, once every table exists
ALTER TABLE "sales_order" ADD FOREIGN KEY ("customer_id") REFERENCES "crm_account" ("id") ON DELETE RESTRICT;

-- +goose Down
DROP TABLE IF EXISTS "sales_order" CASCADE;
DROP TABLE IF EXISTS "crm_account" CASCADE;
",
  "internal/storage/storage.go": "// Package storage opens the Postgres database and migrates it with the goose migrations of the migrations folder.
package storage

import (
	"context"
	"embed"
	"errors"
	"fmt"
	"io/fs"

	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgconn"
	"github.com/jackc/pgx/v5/pgxpool"
	"github.com/jackc/pgx/v5/stdlib"
	"github.com/pressly/goose/v3"
)

//go:embed migrations/*.sql
var migrations embed.FS

// ErrNotFound is returned when no record has the ID.
var ErrNotFound = errors.New("not found")

// Querier runs SQL: a *pgxpool.Pool, a *pgx.Conn or a pgx.Tx.
type Querier interface {
	Exec(ctx context.Context, sql string, args ...any) (pgconn.CommandTag, error)
	Query(ctx context.Context, sql string, args ...any) (pgx.Rows, error)
	QueryRow(ctx context.Context, sql string, args ...any) pgx.Row
}

// Open connects a pool to the database at url, such as postgres://user:password@localhost:5432/app.
func Open(ctx context.Context, url string) (*pgxpool.Pool, error) {
	return pgxpool.New(ctx, url)
}

// Migrate applies the migrations the database has not applied yet.
func Migrate(ctx context.Context, config *pgx.ConnConfig) error {
	db := stdlib.OpenDB(*config)
	defer db.Close()
	dir, err := fs.Sub(migrations, "migrations")
	if err != nil {
		return err
	}
	provider, err := goose.NewProvider(goose.DialectPostgres, db, dir)
	if err != nil {
		return fmt.Errorf("migrations: %w", err)
	}
	if _, err := provider.Up(ctx); err != nil {
		return fmt.Errorf("migrate: %w", err)
	}
	return nil
}
",
  "internal/storage/storagetest/storagetest.go": "// Package storagetest gives each test a fresh, migrated schema of the test database named by DATABASE_URL.
package storagetest

import (
	"context"
	"fmt"
	"os"
	"testing"
	"time"

	"shop/internal/storage"
	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgxpool"
)

// Open returns a pool on a new schema of the database at DATABASE_URL with every migration applied, dropped
// when the test ends. Without DATABASE_URL the test is skipped.
func Open(t testing.TB) *pgxpool.Pool {
	t.Helper()
	url := os.Getenv("DATABASE_URL")
	if url == "" {
		t.Skip("DATABASE_URL is not set")
	}
	ctx := context.Background()
	admin, err := pgx.Connect(ctx, url)
	if err != nil {
		t.Fatalf("connect: %v", err)
	}
	t.Cleanup(func() { _ = admin.Close(ctx) })
	schema := fmt.Sprintf("test_%d_%d", os.Getpid(), time.Now().UnixNano())
	if _, err := admin.Exec(ctx, \`CREATE SCHEMA "\`+schema+\`"\`); err != nil {
		t.Fatalf("create schema: %v", err)
	}
	t.Cleanup(func() { _, _ = admin.Exec(ctx, \`DROP SCHEMA "\`+schema+\`" CASCADE\`) })
	config, err := pgxpool.ParseConfig(url)
	if err != nil {
		t.Fatalf("parse DATABASE_URL: %v", err)
	}
	config.ConnConfig.RuntimeParams["search_path"] = schema
	if err := storage.Migrate(ctx, config.ConnConfig); err != nil {
		t.Fatalf("%v", err)
	}
	pool, err := pgxpool.NewWithConfig(ctx, config)
	if err != nil {
		t.Fatalf("pool: %v", err)
	}
	t.Cleanup(pool.Close)
	return pool
}
",
}
`;
