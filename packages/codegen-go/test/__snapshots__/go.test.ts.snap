  "internal/crm/store.go": "package crm

import (
	"context"
	"errors"
	"fmt"
	"shop/internal/storage"
	"github.com/jackc/pgx/v5"
)


// InsertAccount stores a new Account and sets its ID.
func InsertAccount(ctx context.Context, db storage.Querier, x *Account) error {
	if err := db.QueryRow(ctx, \`INSERT INTO "crm_account" ("name", "email") VALUES ($1, $2) RETURNING "id"\`, x.Name, x.Email).Scan(&x.ID); err != nil {
		return fmt.Errorf("insert Account: %w", err)
	}
	return nil
}

// scanAccount reads a row of "id", "name", "email"; referenced records get their ID only.
func scanAccount(row pgx.Row) (*Account, error) {
	x := &Account{}
	if err := row.Scan(&x.ID, &x.Name, &x.Email); err != nil {
		return nil, err
	}
	return x, nil
}

// GetAccount loads the Account with the ID, or returns storage.ErrNotFound.
func GetAccount(ctx context.Context, db storage.Querier, id int64) (*Account, error) {
	x, err := scanAccount(db.QueryRow(ctx, \`SELECT "id", "name", "email" FROM "crm_account" WHERE "id" = $1\`, id))
	if errors.Is(err, pgx.ErrNoRows) {
		return nil, fmt.Errorf("Account %d: %w", id, storage.ErrNotFound)
	}
	if err != nil {
		return nil, fmt.Errorf("get Account %d: %w", id, err)
	}
	return x, nil
}

// ListAccount loads every Account in the order of their IDs.
func ListAccount(ctx context.Context, db storage.Querier) ([]*Account, error) {
	rows, err := db.Query(ctx, \`SELECT "id", "name", "email" FROM "crm_account" ORDER BY "id"\`)
	if err != nil {
		return nil, fmt.Errorf("list Account: %w", err)
	}
	found, err := pgx.CollectRows(rows, func(row pgx.CollectableRow) (*Account, error) { return scanAccount(row) })
	if err != nil {
		return nil, fmt.Errorf("list Account: %w", err)
	}
	return found, nil
}

// UpdateAccount writes the fields of a stored Account, or returns storage.ErrNotFound.
func UpdateAccount(ctx context.Context, db storage.Querier, x *Account) error {
	tag, err := db.Exec(ctx, \`UPDATE "crm_account" SET "name" = $2, "email" = $3 WHERE "id" = $1\`, x.ID, x.Name, x.Email)
	if err != nil {
		return fmt.Errorf("update Account %d: %w", x.ID, err)
	}
	if tag.RowsAffected() == 0 {
		return fmt.Errorf("Account %d: %w", x.ID, storage.ErrNotFound)
	}
	return nil
}

// DeleteAccount removes a stored Account, or returns storage.ErrNotFound.
func DeleteAccount(ctx context.Context, db storage.Querier, x *Account) error {
	tag, err := db.Exec(ctx, \`DELETE FROM "crm_account" WHERE "id" = $1\`, x.ID)
	if err != nil {
		return fmt.Errorf("delete Account %d: %w", x.ID, err)
	}
	if tag.RowsAffected() == 0 {
		return fmt.Errorf("Account %d: %w", x.ID, storage.ErrNotFound)
	}
	return nil
}
