  "internal/crm/types.go": "package crm

import (
	"errors"
)


// Account is the entity crm.Account.
type Account struct {
	ID int64 \`json:"id"\`
	Name string \`json:"name"\`
	Email string \`json:"email"\`
}

// NewAccount returns a new Account with the defaults of the model.
func NewAccount() *Account {
	return &Account{
	}
}

// Validate checks the invariants of Account.
func (a *Account) Validate() error {
	var errs []error
	return errors.Join(errs...)
}

// TenantID returns the ID of the crm.Account this Account belongs to, for the tenant crm.Company.
func (a *Account) TenantID() (int64, bool) {
	return a.ID, true
}
