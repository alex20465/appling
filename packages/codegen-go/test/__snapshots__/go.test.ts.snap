  "internal/sales/store.go": "package sales

import (
	"context"
	"errors"
	"fmt"
	"shop/internal/crm"
	"shop/internal/storage"
	"github.com/jackc/pgx/v5"
)


// InsertOrder stores a new Order and sets its ID.
func InsertOrder(ctx context.Context, db storage.Querier, x *Order) error {
	var customerID *int64
	if x.Customer != nil {
		customerID = &x.Customer.ID
	}
	if err := db.QueryRow(ctx, \`INSERT INTO "sales_order" ("reference", "customer_id", "lines", "status", "created_at", "placed_at", "paid_at") VALUES ($1, $2, $3, $4, $5, $6, $7) RETURNING "id"\`, x.Reference, customerID, x.Lines, x.Status, x.CreatedAt, x.PlacedAt, x.PaidAt).Scan(&x.ID); err != nil {
		return fmt.Errorf("insert Order: %w", err)
	}
	return nil
}

// scanOrder reads a row of "id", "reference", "customer_id", "lines", "status", "created_at", "placed_at", "paid_at"; referenced records get their ID only.
func scanOrder(row pgx.Row) (*Order, error) {
	x := &Order{}
	var customerID *int64
	if err := row.Scan(&x.ID, &x.Reference, &customerID, &x.Lines, &x.Status, &x.CreatedAt, &x.PlacedAt, &x.PaidAt); err != nil {
		return nil, err
	}
	if customerID != nil {
		x.Customer = &crm.Account{ID: *customerID}
	}
	return x, nil
}

// GetOrder loads the Order with the ID, or returns storage.ErrNotFound.
func GetOrder(ctx context.Context, db storage.Querier, id int64) (*Order, error) {
	x, err := scanOrder(db.QueryRow(ctx, \`SELECT "id", "reference", "customer_id", "lines", "status", "created_at", "placed_at", "paid_at" FROM "sales_order" WHERE "id" = $1\`, id))
	if errors.Is(err, pgx.ErrNoRows) {
		return nil, fmt.Errorf("Order %d: %w", id, storage.ErrNotFound)
	}
	if err != nil {
		return nil, fmt.Errorf("get Order %d: %w", id, err)
	}
	return x, nil
}

// ListOrder loads every Order in the order of their IDs.
func ListOrder(ctx context.Context, db storage.Querier) ([]*Order, error) {
	rows, err := db.Query(ctx, \`SELECT "id", "reference", "customer_id", "lines", "status", "created_at", "placed_at", "paid_at" FROM "sales_order" ORDER BY "id"\`)
	if err != nil {
		return nil, fmt.Errorf("list Order: %w", err)
	}
	found, err := pgx.CollectRows(rows, func(row pgx.CollectableRow) (*Order, error) { return scanOrder(row) })
	if err != nil {
		return nil, fmt.Errorf("list Order: %w", err)
	}
	return found, nil
}

// UpdateOrder writes the fields of a stored Order, or returns storage.ErrNotFound.
func UpdateOrder(ctx context.Context, db storage.Querier, x *Order) error {
	var customerID *int64
	if x.Customer != nil {
		customerID = &x.Customer.ID
	}
	tag, err := db.Exec(ctx, \`UPDATE "sales_order" SET "reference" = $2, "customer_id" = $3, "lines" = $4, "status" = $5, "created_at" = $6, "placed_at" = $7, "paid_at" = $8 WHERE "id" = $1\`, x.ID, x.Reference, customerID, x.Lines, x.Status, x.CreatedAt, x.PlacedAt, x.PaidAt)
	if err != nil {
		return fmt.Errorf("update Order %d: %w", x.ID, err)
	}
	if tag.RowsAffected() == 0 {
		return fmt.Errorf("Order %d: %w", x.ID, storage.ErrNotFound)
	}
	return nil
}

// DeleteOrder removes a stored Order, or returns storage.ErrNotFound.
func DeleteOrder(ctx context.Context, db storage.Querier, x *Order) error {
	tag, err := db.Exec(ctx, \`DELETE FROM "sales_order" WHERE "id" = $1\`, x.ID)
	if err != nil {
		return fmt.Errorf("delete Order %d: %w", x.ID, err)
	}
	if tag.RowsAffected() == 0 {
		return fmt.Errorf("Order %d: %w", x.ID, storage.ErrNotFound)
	}
	return nil
}
