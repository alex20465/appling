  "internal/sales/policies.go": "package sales

import (
	"shop/internal/access"
	"shop/internal/crm"
	"time"
)


// CanReadOrder reports whether the policies of sales.Order let the actor read the record.
func CanReadOrder(actor access.Actor, order *Order) bool {
	return access.InTenant(actor, order) && orderPolicyRead(actor, order)
}

// CanReadOrderTotal reports whether the actor may read the field total of the record.
func CanReadOrderTotal(actor access.Actor, order *Order) bool {
	return CanReadOrder(actor, order) && orderPolicyReadFieldsTotal(actor, order)
}

// CanCreateOrder reports whether the policies of sales.Order let the actor create the record.
func CanCreateOrder(actor access.Actor, order *Order) bool {
	return access.InTenant(actor, order) && orderPolicyCreateDelete(actor, order)
}

// CanUpdateOrder reports whether the policies of sales.Order let the actor update the record.
func CanUpdateOrder(actor access.Actor, order *Order) bool {
	return access.InTenant(actor, order) && orderPolicyUpdate(actor, order)
}

// CanDeleteOrder reports whether the policies of sales.Order let the actor delete the record.
func CanDeleteOrder(actor access.Actor, order *Order) bool {
	return access.InTenant(actor, order) && orderPolicyCreateDelete(actor, order)
}

// orderPolicyRead is the policy sales.Order.policy[read]: actor.is(crm.Clerk) || (actor.is(Customer) && customer == actor.account)
func orderPolicyRead(actor access.Actor, order *Order) bool {
	return access.IsClerk(actor) || (access.IsCustomer(actor) && access.Same(actor.Account, order.Customer.ID))
}

// orderPolicyCreateDelete is the policy sales.Order.policy[create,delete]: actor.is(crm.Clerk)
func orderPolicyCreateDelete(actor access.Actor, order *Order) bool {
	return access.IsClerk(actor)
}

// orderPolicyUpdate is the policy sales.Order.policy[update]: actor.is(crm.Clerk) || (actor.is(Customer) && customer == actor.account && status == draft)
func orderPolicyUpdate(actor access.Actor, order *Order) bool {
	return access.IsClerk(actor) || ((access.IsCustomer(actor) && access.Same(actor.Account, order.Customer.ID)) && (order.Status == OrderStatusDraft))
}

// orderPolicyReadFieldsTotal is the policy sales.Order.policy[read fields total]: actor.is(crm.Clerk) || (actor.is(Customer) && status != draft)
func orderPolicyReadFieldsTotal(actor access.Actor, order *Order) bool {
	return access.IsClerk(actor) || (access.IsCustomer(actor) && (order.Status != OrderStatusDraft))
}

// CanPlaceOrder reports whether the actor may run sales.PlaceOrder, including the update check of sales.Order.
func CanPlaceOrder(actor access.Actor, order *Order) bool {
	return CanUpdateOrder(actor, order) && placeOrderPolicy(actor, order)
}

// placeOrderPolicy is the policy sales.PlaceOrder.policy[]: actor.is(Customer) && customer == actor.account
func placeOrderPolicy(actor access.Actor, order *Order) bool {
	return access.IsCustomer(actor) && access.Same(actor.Account, order.Customer.ID)
}

// CanCancel reports whether the actor may run sales.Cancel, including the update check of sales.Order.
func CanCancel(actor access.Actor, order *Order, reason *string) bool {
	return CanUpdateOrder(actor, order) && cancelPolicy(actor, order, reason)
}

// cancelPolicy is the policy sales.Cancel.policy[]: actor.is(crm.Clerk)
func cancelPolicy(actor access.Actor, order *Order, reason *string) bool {
	return access.IsClerk(actor)
}

// CanOpenOrders reports whether the actor may read a record through sales.OpenOrders, including the read check of sales.Order.
func CanOpenOrders(actor access.Actor, order *Order) bool {
	return CanReadOrder(actor, order)
}

// CanOrdersOf reports whether the actor may read a record through sales.OrdersOf, including the read check of sales.Order.
func CanOrdersOf(actor access.Actor, order *Order, of *crm.Account, since *time.Time) bool {
	return CanReadOrder(actor, order)
}
",
  "internal/sales/queries.go": "package sales

import (
	"shop/internal/crm"
	"slices"
	"time"
)


// InOpenOrders reports whether a record is among the results of the query sales.OpenOrders.
func InOpenOrders(order *Order) bool {
	return slices.Contains([]OrderStatus{OrderStatusPlaced, OrderStatusPaid}, order.Status)
}

// InOrdersOf reports whether a record is among the results of the query sales.OrdersOf for the inputs.
func InOrdersOf(order *Order, of *crm.Account, since *time.Time) bool {
	return (order.Customer.ID == of.ID) && ((since == nil) || (!(*order.PlacedAt).Before((*since))))
}
