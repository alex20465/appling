// ptr returns a pointer to a copy of v, for optional fields.
func ptr[T any](v T) *T { return &v }
",
  "internal/crm/types.go": "package crm

import (
	"errors"
)


// Account is the entity crm.Account.
type Account struct {
	ID int64 \`json:"id"\`
	Name string \`json:"name"\`
	Email string \`json:"email"\`
}

// NewAccount returns a new Account with the defaults of the model.
