  "internal/sales/events.go": "package sales


// OrderPlaced is the event sales.OrderPlaced.
type OrderPlaced struct {
	Order *Order \`json:"order"\`
}

// PaymentReceived is the event sales.PaymentReceived.
type PaymentReceived struct {
	Order *Order \`json:"order"\`
}
",
  "internal/sales/machines.go": "package sales

import (
	"fmt"
)


// OrderFlowOnPaymentReceived applies the transitions of sales.OrderFlow that PaymentReceived triggers.
func OrderFlowOnPaymentReceived(event PaymentReceived) ([]any, error) {
	var events []any
	switch {
	case event.Order.Status == OrderStatusPlaced:
		event.Order.Status = OrderStatusPaid
	default:
		return nil, fmt.Errorf("%w: PaymentReceived from %s", ErrInvalidTransition, event.Order.Status)
	}
	return events, nil
}
