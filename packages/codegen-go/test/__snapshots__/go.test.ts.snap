exports[`examples generate Go packages for the domain and behavior layers 1`] = `
{
  "internal/access/access.go": "// Package access holds the actors, roles and tenant of the model and the checks its policies call.
package access

import (
	"errors"
	"slices"
)

// ErrForbidden is returned by an action when its policies do not grant it to the actor.
var ErrForbidden = errors.New("forbidden")

// Role is a role of the model, by qualified name.
type Role string

const (
	// RoleClerk is the role crm.Clerk.
	RoleClerk Role = "crm.Clerk"
	// RoleCustomer is the role sales.Customer.
	RoleCustomer Role = "sales.Customer"
)

// ActorType is a declared actor of the model, by qualified name.
type ActorType string

const (
	// ActorEmployee is the human actor crm.Employee.
	ActorEmployee ActorType = "crm.Employee"
	// ActorShopper is the human actor sales.Shopper.
	ActorShopper ActorType = "sales.Shopper"
)

// Actor is who acts: a declared actor with the roles it carries, the tenant it acts in, and the fields
// the actors declare. A field is nil for actors that do not declare it; fields that hold records hold their ID.
type Actor struct {
	Type  ActorType \`json:"type"\`
	Roles []Role    \`json:"roles"\`
	// ID is the record the actor is stored as, for actors declared with \`is\`.
	ID *int64 \`json:"id"\`
	// Tenant is the ID of the crm.Account the actor acts in (the tenant crm.Company); nil when it acts across tenants.
	Tenant *int64 \`json:"tenant"\`
	// Account is the field account of sales.Shopper, the ID of a crm.Account.
	Account *int64 \`json:"account"\`
	// system marks a call the system makes; only System sets it.
	system bool
}

// System returns the actor of a call the system makes, such as a job, an event handler or a scenario without
// an actor: the actions check no policy and no tenant for it. The zero Actor is not the system.
func System() Actor {
	return Actor{system: true}
}

// IsSystem reports whether the call is one the system makes, which the actions do not check.
func (a Actor) IsSystem() bool {
	return a.system
}

// NewEmployee returns the actor crm.Employee with the roles it declares.
func NewEmployee() Actor {
	return Actor{Type: ActorEmployee, Roles: []Role{RoleClerk}}
}

// NewShopper returns the actor sales.Shopper with the roles it declares.
func NewShopper() Actor {
	return Actor{Type: ActorShopper, Roles: []Role{RoleCustomer}}
}

// Has reports whether the actor carries the role, without checking the role's condition.
func (a Actor) Has(role Role) bool {
	return slices.Contains(a.Roles, role)
}

// IsClerk reports whether the actor is crm.Clerk: it carries the role.
func IsClerk(actor Actor) bool {
	return actor.Has(RoleClerk)
}

// IsCustomer reports whether the actor is sales.Customer: it carries the role.
func IsCustomer(actor Actor) bool {
	return actor.Has(RoleCustomer)
}

// Value returns what an optional actor field points to, or the zero value when the actor does not have it.
func Value[T any](p *T) T {
	if p == nil {
		var zero T
		return zero
	}
	return *p
}

// Same reports whether a record ID of the actor refers to the record with the given ID.
func Same(ref *int64, id int64) bool {
	return ref != nil && *ref == id
}

// SameRef reports whether two record IDs of the actor refer to the same record.
func SameRef(a, b *int64) bool {
	return a != nil && b != nil && *a == *b
}

// Tenanted is a record that belongs to a crm.Account, the entity of the tenant crm.Company.
type Tenanted interface {
	// TenantID returns the ID of the crm.Account, and false when the record does not reach one.
	TenantID() (int64, bool)
}

// InTenant reports whether the record belongs to the tenant the actor acts in. An actor without a tenant acts across tenants.
func InTenant(actor Actor, record Tenanted) bool {
	if actor.Tenant == nil {
		return true
	}
	id, ok := record.TenantID()
	return ok && id == *actor.Tenant
}
",
  "internal/crm/crm_test.go": "package crm

import (
	"context"
	"errors"
	"shop/internal/storage"
	"shop/internal/storage/storagetest"
	"testing"
)


// validAccount returns an Account with the defaults of the model and a sample value for every other required field.
func validAccount() *Account {
	x := NewAccount()
	x.Name = "name-1"
	x.Email = "email-1"
	return x
}

func TestStoreAccount(t *testing.T) {
	db := storagetest.Open(t)
	ctx := context.Background()
	x := validAccount()
	if err := InsertAccount(ctx, db, x); err != nil {
		t.Fatalf("InsertAccount: %v", err)
	}
	got, err := GetAccount(ctx, db, x.ID)
	if err != nil {
		t.Fatalf("GetAccount: %v", err)
	}
	if got.ID != x.ID {
		t.Fatalf("GetAccount: want ID %d, got %d", x.ID, got.ID)
	}
	if err := UpdateAccount(ctx, db, got); err != nil {
		t.Fatalf("UpdateAccount: %v", err)
	}
	if all, err := ListAccount(ctx, db); err != nil || len(all) != 1 {
		t.Fatalf("ListAccount: want 1 record, got %d (%v)", len(all), err)
	}
	if err := DeleteAccount(ctx, db, got); err != nil {
		t.Fatalf("DeleteAccount: %v", err)
	}
	if _, err := GetAccount(ctx, db, x.ID); !errors.Is(err, storage.ErrNotFound) {
		t.Fatalf("GetAccount after DeleteAccount: want storage.ErrNotFound, got %v", err)
	}
}

func TestAccountPolicyRead(t *testing.T) {
	t.Skip("registry task: crm.Account.policy[read]")
}
