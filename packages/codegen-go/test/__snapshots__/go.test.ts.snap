import (
	"errors"
)


// ErrEmptyOrder is the declared error sales.PlaceOrder.EmptyOrder.
var ErrEmptyOrder = errors.New("EmptyOrder")

// ErrInvalidTransition is returned when the state does not allow an action.
var ErrInvalidTransition = errors.New("invalid transition")

// ErrDeclined is the declared error sales.Payments.Charge.Declined.
var ErrDeclined = errors.New("Declined")
