  "internal/sales/actions.go": "package sales

import (
	"fmt"
	"time"
)


// PlaceOrder is the action sales.PlaceOrder. It returns the events it emits.
func PlaceOrder(order *Order) ([]any, error) {
	var events []any
	if !(int64(len(order.Lines)) > 0) {
		return nil, ErrEmptyOrder
	}
	switch {
	case order.Status == OrderStatusDraft:
		events = append(events, OrderPlaced{Order: order})
		order.Status = OrderStatusPlaced
	default:
		return nil, fmt.Errorf("%w: PlaceOrder from %s", ErrInvalidTransition, order.Status)
	}
	order.PlacedAt = ptr(time.Now())
	return events, nil
}

// Cancel is the action sales.Cancel. It returns the events it emits.
func Cancel(order *Order, reason *string) ([]any, error) {
	var events []any
	switch {
	case (order.Status == OrderStatusDraft || order.Status == OrderStatusPlaced) && (!(order.PaidAt != nil)):
		order.Status = OrderStatusCancelled
	default:
		return nil, fmt.Errorf("%w: Cancel from %s", ErrInvalidTransition, order.Status)
	}
	return events, nil
}
",
