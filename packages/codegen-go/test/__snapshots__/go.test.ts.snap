  "internal/sales/scenarios_test.go": "package sales_test

import (
	"errors"
	"shop/internal/access"
	"shop/internal/crm"
	"shop/internal/sales"
	"testing"
	"time"
)


// ptr returns a pointer to a copy of v, for optional fields.
func ptr[T any](v T) *T { return &v }

// TestScenarioClerkCancelsDraft runs the scenario sales.ClerkCancelsDraft: A clerk cancels a draft order
func TestScenarioClerkCancelsDraft(t *testing.T) {
	acme := crm.NewAccount()
	acme.ID = 1
	acme.Name = "Acme"
	acme.Email = "email-1"
	order := sales.NewOrder()
	order.ID = 2
	order.Reference = "A-1"
	order.Customer = acme
	order.CreatedAt = time.Now()
	actor := access.NewEmployee()
	_, err := sales.Cancel(actor, order, ptr("changed mind"))
	if err != nil {
		t.Fatalf("Cancel: %v", err)
	}
	if !(order.Status == sales.OrderStatusCancelled) {
		t.Error("order.status == cancelled is false")
	}
}

// TestScenarioEmptyOrderIsRefused runs the scenario sales.EmptyOrderIsRefused.
func TestScenarioEmptyOrderIsRefused(t *testing.T) {
	acme := crm.NewAccount()
	acme.ID = 1
	acme.Name = "Acme"
	acme.Email = "email-1"
	order := sales.NewOrder()
	order.ID = 2
	order.Reference = "A-2"
	order.Customer = acme
	order.CreatedAt = time.Now()
	actor := access.NewShopper()
	actor.Account = ptr(acme.ID)
	_, err := sales.PlaceOrder(actor, order)
	if !errors.Is(err, sales.ErrEmptyOrder) {
		t.Fatalf("PlaceOrder: want sales.ErrEmptyOrder, got %v", err)
	}
}

// TestScenarioOnlyOwnOrders runs the scenario sales.OnlyOwnOrders.
func TestScenarioOnlyOwnOrders(t *testing.T) {
	acme := crm.NewAccount()
	acme.ID = 1
	acme.Name = "Acme"
	acme.Email = "email-1"
	globex := crm.NewAccount()
	globex.ID = 2
	globex.Name = "Globex"
	globex.Email = "email-1"
	order := sales.NewOrder()
	order.ID = 3
	order.Reference = "A-3"
	order.Customer = acme
	order.CreatedAt = time.Now()
	actor := access.NewShopper()
	actor.Account = ptr(globex.ID)
	_, err := sales.PlaceOrder(actor, order)
	if !errors.Is(err, access.ErrForbidden) {
		t.Fatalf("PlaceOrder: want access.ErrForbidden, got %v", err)
	}
}
