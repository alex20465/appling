{
  "name": "@appling/ide",
  "private": true,
  "version": "0.1.3",
  "description": "Appling Desktop's repo view: the IDE server each repo runs and its client (canvas, search, inspector, editor), plus the browser demo of the landing site",
  "homepage": "https://www.appling.tools/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex20465/appling.git",
    "directory": "packages/ide"
  },
  "type": "module",
  "files": [
    "out",
    "dist/client"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json && vite build && vite build -c vite.demo.config.ts"
  },
  "dependencies": {
    "@appling/ai": "workspace:*",
    "@appling/codegen": "workspace:*",
    "@appling/lang": "workspace:*",
    "@appling/model": "workspace:*",
    "@appling/viz": "workspace:*",
    "langium": "4.4.0",
    "vscode-languageserver": "~10.1.0",
    "vscode-ws-jsonrpc": "4.0.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "license": "MIT"
}
