{
  "name": "@appling/ide",
  "version": "0.1.2",
  "description": "Appling IDE: the model as text, entity view and search, in the browser",
  "type": "module",
  "bin": {
    "appling-ide": "./out/server/main.js"
  },
  "files": [
    "out",
    "dist/client"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json && vite build && vite build -c vite.demo.config.ts"
  },
  "dependencies": {
    "@appling/ai": "workspace:*",
    "@appling/lang": "workspace:*",
    "@appling/model": "workspace:*",
    "@appling/viz": "workspace:*",
    "ai": "7.0.149",
    "langium": "4.4.0",
    "vscode-languageserver": "~10.1.0",
    "vscode-ws-jsonrpc": "4.0.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
