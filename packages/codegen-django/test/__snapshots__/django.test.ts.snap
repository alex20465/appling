  "sales/management/commands/expire_drafts.py": "from django.core.management.base import BaseCommand
from sales.jobs import expire_drafts


class Command(BaseCommand):
    help = "Runs the job ExpireDrafts, scheduled as \\"0 3 * * *\\"."

    def handle(self, *args, **options):
        expire_drafts.enqueue()
