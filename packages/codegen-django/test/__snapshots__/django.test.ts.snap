  "sales/actions.py": "from django.db import transaction
from django.utils import timezone
from sales.enums import OrderStatus
from sales.errors import EmptyOrder, InvalidTransition
from sales.events import order_placed
from sales.models import Order


@transaction.atomic
def place_order(order: Order, *, actor=None) -> None:
    if not (len(order.lines) > 0):
        raise EmptyOrder()
    if order.status in (OrderStatus.DRAFT,):
        transaction.on_commit(lambda: order_placed.send(sender=None, order=order))
        order.status = OrderStatus.PLACED
    else:
        raise InvalidTransition("place_order", order.status)
    order.placed_at = timezone.now()
    order.save()


@transaction.atomic
def cancel(order: Order, *, reason: str | None = None, actor=None) -> None:
    if order.status in (OrderStatus.DRAFT, OrderStatus.PLACED) and (not (order.paid_at is not None)):
        order.status = OrderStatus.CANCELLED
    else:
        raise InvalidTransition("cancel", order.status)
    order.save()
",
  "sales/api.py": "from django.shortcuts import get_object_or_404
from rest_framework import generics, pagination, throttling, views
from rest_framework.response import Response
from sales.actions import place_order
from sales.errors import EmptyOrder, InvalidTransition
from sales.models import Order
from sales.queries import OPEN_ORDERS_PAGE_SIZE, open_orders
from sales.serializers import OrderSummary


class PublicApiThrottle(throttling.UserRateThrottle):
    rate = "100/minute"


class PublicApiOpenOrdersSerializer(OrderSummary):
    class Meta(OrderSummary.Meta):
        fields = ["reference", "status", "total"]


class PublicApiOpenOrdersPagination(pagination.PageNumberPagination):
    page_size = OPEN_ORDERS_PAGE_SIZE


class PublicApiOpenOrders(generics.ListAPIView):
    serializer_class = PublicApiOpenOrdersSerializer
    pagination_class = PublicApiOpenOrdersPagination
    throttle_classes = [PublicApiThrottle]

    def get_queryset(self):
        return open_orders()


class PublicApiPlaceOrder(views.APIView):
    throttle_classes = [PublicApiThrottle]

    def post(self, request, id):
        order = get_object_or_404(Order, pk=id)
        try:
            place_order(order, actor=request.user)
        except (InvalidTransition, EmptyOrder) as error:
            return Response({"error": type(error).__name__}, status=400)
        return Response(status=204)
",
