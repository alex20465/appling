  "sales/models.py": "from decimal import Decimal
from django.contrib.auth.models import AbstractUser
from django.core.serializers.json import DjangoJSONEncoder
from django.db import models
from sales.enums import OrderStatus


class Order(models.Model):
    reference = models.CharField(max_length=255, unique=True)
    customer = models.ForeignKey("crm.Account", on_delete=models.PROTECT)
    lines = models.JSONField(encoder=DjangoJSONEncoder, default=list)
    status = models.CharField(max_length=32, choices=OrderStatus.choices, default=OrderStatus.DRAFT)
    created_at = models.DateTimeField()
    placed_at = models.DateTimeField(null=True, blank=True)
    paid_at = models.DateTimeField(null=True, blank=True)

    @property
    def total(self):
        return sum([Decimal(l["amount"]) for l in self.lines])


class User(AbstractUser):
    account = models.ForeignKey("crm.Account", on_delete=models.PROTECT, null=True, blank=True)
",
  "sales/pages.py": "from django.contrib import messages
from django.core.exceptions import PermissionDenied
from django.core.paginator import Paginator
from django.shortcuts import get_object_or_404, redirect, render
from django.utils.translation import get_language
from django.views.decorators.http import require_POST
from sales.actions import cancel, place_order
from sales.errors import EmptyOrder, InvalidTransition
from sales.messages import LABELS
from sales.models import Order
from sales.policies import can_read_order, can_read_order_total
from sales.queries import OPEN_ORDERS_PAGE_SIZE, open_orders


def value(obj, path):
    """Follows a dotted path such as "customer.name"; None when a step is missing."""
    for part in path.split("."):
        obj = getattr(obj, part, None) if obj is not None else None
    return obj


def label(key, default):
    return LABELS.get(get_language()[:2], {}).get(key, default)


def orders(request):
    components = []
    rows = open_orders(actor=request.user)
    rows = Paginator(rows, OPEN_ORDERS_PAGE_SIZE).get_page(request.GET.get("page"))
    components.append({
        "kind": "list",
        "columns": [label("OrderSummary.reference", "Reference"), label("OrderSummary.status", "Status"), label("OrderSummary.total", "Total")],
        "items": [{"id": row.pk, "values": [value(row, "reference"), value(row, "status"), (value(row, "total") if can_read_order_total(request.user, row) else None)]} for row in rows],
        "page": rows,
        "actions": [{"label": "Cancel", "url": "/_actions/sales/cancel/"}],
    })
    return render(request, "sales/page.html", {"title": "Orders", "components": components})


@require_POST
def run_cancel(request, id):
    order = get_object_or_404(Order, pk=id)
    try:
        cancel(order, reason=request.POST.get("reason") or None, actor=request.user)
        messages.success(request, "Cancel done.")
    except (InvalidTransition,) as error:
        messages.error(request, "Cancel failed: " + type(error).__name__)
    return redirect(request.POST.get("next") or "/")


def order_detail(request, id):
    components = []
    record = get_object_or_404(Order, pk=id)
    if not can_read_order(request.user, record):
        raise PermissionDenied()
    components.append({
        "kind": "detail",
        "id": record.pk,
        "fields": [(label("OrderSummary.reference", "Reference"), value(record, "reference")), (label("OrderSummary.status", "Status"), value(record, "status")), (label("OrderSummary.total", "Total"), (value(record, "total") if can_read_order_total(request.user, record) else None)), (label("OrderSummary.customer_name", "Customer name"), value(record, "customer.name"))],
        "actions": [{"label": "PlaceOrder", "url": "/_actions/sales/place_order/"}, {"label": "Cancel", "url": "/_actions/sales/cancel/"}],
    })
    components.append({
        "kind": "form",
        "label": "Cancel",
        "url": "/_actions/sales/cancel/" + str(id) + "/",
        "inputs": [("reason", "Reason")],
    })
    return render(request, "sales/page.html", {"title": "Order detail", "components": components})


@require_POST
def run_place_order(request, id):
    order = get_object_or_404(Order, pk=id)
    try:
        place_order(order, actor=request.user)
        messages.success(request, "PlaceOrder done.")
    except (EmptyOrder, InvalidTransition) as error:
        messages.error(request, "PlaceOrder failed: " + type(error).__name__)
    return redirect(request.POST.get("next") or "/")
",
  "sales/policies.py": "from django.db import models
from crm.roles import is_clerk
from sales.enums import OrderStatus
from sales.roles import is_customer


def can_read_order(actor, order) -> bool:
    if not getattr(actor, "is_authenticated", False):
        return False
    return is_clerk(actor) or (is_customer(actor) and (order.customer == actor.account))


def can_create_order(actor, order) -> bool:
    if not getattr(actor, "is_authenticated", False):
        return False
    return is_clerk(actor)


def can_update_order(actor, order) -> bool:
    if not getattr(actor, "is_authenticated", False):
        return False
    return is_clerk(actor) or ((is_customer(actor) and (order.customer == actor.account)) and (order.status == OrderStatus.DRAFT))


def can_delete_order(actor, order) -> bool:
    if not getattr(actor, "is_authenticated", False):
        return False
    return is_clerk(actor)


def can_read_order_total(actor, order) -> bool:
    return can_read_order(actor, order) and (is_clerk(actor) or (is_customer(actor) and (order.status != OrderStatus.DRAFT)))


def readable_order_rows(actor, rows):
    """Narrows a queryset of Order to the rows the actor may read."""
    if not getattr(actor, "is_authenticated", False):
        return rows.none()
    return rows.filter(((models.Q(pk__isnull=False) if is_clerk(actor) else models.Q(pk__in=[]))) | (((models.Q(pk__isnull=False) if is_customer(actor) else models.Q(pk__in=[]))) & (models.Q(customer=actor.account))))
",
  "sales/queries.py": "from django.db import models
from sales.models import Order
from sales.policies import readable_order_rows


OPEN_ORDERS_PAGE_SIZE = 50


def open_orders(actor=None):
    rows = Order.objects.filter(models.Q(status__in=["placed", "paid"])).order_by("-placed_at")
    if actor is None:
        return rows
    if not actor.is_authenticated:
        return rows.none()
    rows = readable_order_rows(actor, rows)
    return rows
",
