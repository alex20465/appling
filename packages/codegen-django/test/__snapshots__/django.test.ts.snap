  "sales/actions.py": "from django.core.exceptions import PermissionDenied
from django.db import transaction
from django.utils import timezone
from crm.roles import is_clerk
from sales.enums import OrderStatus
from sales.errors import EmptyOrder, InvalidTransition
from sales.events import order_placed
from sales.models import Order
from sales.policies import can_update_order
from sales.roles import is_customer


@transaction.atomic
def place_order(order: Order, *, actor=None) -> None:
    if actor is not None and not (actor.is_authenticated and can_update_order(actor, order) and (is_customer(actor) and (order.customer == actor.account))):
        raise PermissionDenied("PlaceOrder")
    if not (len(order.lines) > 0):
        raise EmptyOrder()
    if order.status in (OrderStatus.DRAFT,):
        transaction.on_commit(lambda: order_placed.send(sender=None, order=order))
        order.status = OrderStatus.PLACED
    else:
        raise InvalidTransition("place_order", order.status)
    order.placed_at = timezone.now()
    order.save()


@transaction.atomic
def cancel(order: Order, *, reason: str | None = None, actor=None) -> None:
    if actor is not None and not (actor.is_authenticated and can_update_order(actor, order) and is_clerk(actor)):
        raise PermissionDenied("Cancel")
    if order.status in (OrderStatus.DRAFT, OrderStatus.PLACED) and (not (order.paid_at is not None)):
        order.status = OrderStatus.CANCELLED
    else:
        raise InvalidTransition("cancel", order.status)
    order.save()
