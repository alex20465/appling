from sales.enums import OrderStatus
from sales.errors import InvalidTransition
from sales.events import payment_received


@receiver(payment_received)
def order_flow_on_payment_received(sender, order, **kwargs) -> None:
    if order.status in (OrderStatus.PLACED,):
        order.status = OrderStatus.PAID
    else:
        raise InvalidTransition("payment_received", order.status)
    order.save()
