  "crm/tenants.py": "from contextvars import ContextVar


_company: ContextVar = ContextVar("company", default=None)


def current_company():
    """The Account that is the current tenant, or None outside a request."""
    return _company.get()


class CompanyMiddleware:
    """Sets the current tenant for each request: the account of the signed in user."""

    def __init__(self, get_response):
        self.get_response = get_response

    def __call__(self, request):
        token = _company.set(getattr(request.user, "account", None))
        try:
            return self.get_response(request)
        finally:
            _company.reset(token)
