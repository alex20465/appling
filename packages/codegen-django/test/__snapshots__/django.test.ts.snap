  "sales/serializers.py": "from rest_framework import serializers
from sales.models import Order
from sales.policies import can_read_order_total


class OrderSummary(serializers.ModelSerializer):
    total = serializers.ReadOnlyField()
    customer_name = serializers.ReadOnlyField(source="customer.name")

    class Meta:
        model = Order
        fields = ["reference", "status", "total", "customer_name"]

    def to_representation(self, instance):
        """Hides the fields the requesting actor may not read; without a request nothing is hidden."""
        data = super().to_representation(instance)
        actor = getattr(self.context.get("request"), "user", None)
        if actor is None:
            return data
        if "total" in data and not can_read_order_total(actor, instance):
            data["total"] = None
        return data
