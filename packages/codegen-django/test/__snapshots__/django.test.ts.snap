    def test_allows_permitted_actors(self):
        self.skipTest("registry task: sales.Cancel.policy[]")

    def test_denies_other_actors(self):
        self.skipTest("registry task: sales.Cancel.policy[]")


class OrderFlowDraftToPlacedTest(TestCase):
    """sales.OrderFlow.transition[draft->placed]: draft -> placed via PlaceOrder"""

    def test_moves_from_allowed_states(self):
        self.skipTest("registry task: sales.OrderFlow.transition[draft->placed]")

    def test_refuses_other_states(self):
        self.skipTest("registry task: sales.OrderFlow.transition[draft->placed]")


class OrderFlowPlacedToPaidTest(TestCase):
    """sales.OrderFlow.transition[placed->paid]: placed -> paid via PaymentReceived"""

    def test_moves_from_allowed_states(self):
        for state in (OrderStatus.PLACED,):
            with self.subTest(state=state):
                order = make_order(status=state)
                payment_received.send(sender=None, order=order)
                order.refresh_from_db()
                self.assertEqual(order.status, OrderStatus.PAID)

    def test_refuses_other_states(self):
        for state in (OrderStatus.DRAFT, OrderStatus.PAID, OrderStatus.CANCELLED):
            with self.subTest(state=state):
                order = make_order(status=state)
                with self.assertRaises(InvalidTransition):
                    payment_received.send(sender=None, order=order)


class OrderFlowDraftPlacedToCancelledTest(TestCase):
    """sales.OrderFlow.transition[draft,placed->cancelled]: draft, placed -> cancelled via Cancel when !has(paid_at)"""

    def test_moves_from_allowed_states(self):
        for state in (OrderStatus.DRAFT, OrderStatus.PLACED):
            with self.subTest(state=state):
                order = make_order(status=state)
                cancel(order)
                order.refresh_from_db()
                self.assertEqual(order.status, OrderStatus.CANCELLED)

    def test_refuses_other_states(self):
        for state in (OrderStatus.PAID, OrderStatus.CANCELLED):
            with self.subTest(state=state):
                order = make_order(status=state)
                with self.assertRaises(InvalidTransition):
                    cancel(order)
