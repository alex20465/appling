from sales.errors import Declined
from sales.externals import Payments
from sales.models import Order


def checkout(order: Order, *, actor=None, payments: Payments) -> None:
    place_order(order, actor=actor)
    try:
        payments.charge(order.total)
    except Declined:
        cancel(order, actor=actor)
