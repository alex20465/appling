from crm.roles import is_clerk
from sales.roles import is_customer


def can_read_account(actor, account) -> bool:
    if not getattr(actor, "is_authenticated", False):
        return False
    return is_clerk(actor) or (is_customer(actor) and (actor.account == account))


def can_create_account(actor, account) -> bool:
    return False  # no policy grants create


def can_update_account(actor, account) -> bool:
    return False  # no policy grants update


def can_delete_account(actor, account) -> bool:
    return False  # no policy grants delete


def readable_account_rows(actor, rows):
    """Narrows a queryset of Account to the rows the actor may read."""
    if not getattr(actor, "is_authenticated", False):
        return rows.none()
    return rows.filter(((models.Q(pk__isnull=False) if is_clerk(actor) else models.Q(pk__in=[]))) | (((models.Q(pk__isnull=False) if is_customer(actor) else models.Q(pk__in=[]))) & (models.Q(pk=getattr(actor.account, "pk", None)))))
