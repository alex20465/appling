{
  "name": "@appling/inspect",
  "version": "0.1.3",
  "description": "Appling Inspect: a read only server per repo and its client (canvas, floating inspector, task board) that follows the model live next to an AI coding tool, for Appling Desktop, the VS Code extension and `appling inspect`, plus the browser demo of the landing site",
  "homepage": "https://www.appling.tools/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex20465/appling.git",
    "directory": "packages/inspect"
  },
  "type": "module",
  "exports": {
    "./process": {
      "types": "./out/server/process.d.ts",
      "default": "./out/server/process.js"
    },
    "./panels": {
      "types": "./out/shared/panels.d.ts",
      "default": "./out/shared/panels.js"
    },
    "./host-requests": {
      "types": "./out/server/host-requests.d.ts",
      "default": "./out/server/host-requests.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "out",
    "dist/client"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json && vite build && vite build -c vite.demo.config.ts"
  },
  "dependencies": {
    "@appling/ai": "workspace:*",
    "@appling/codegen": "workspace:*",
    "@appling/lang": "workspace:*",
    "@appling/model": "workspace:*",
    "@appling/viz": "workspace:*",
    "langium": "4.4.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
