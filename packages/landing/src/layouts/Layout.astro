---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Mascots from "../components/Mascots.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="bg-surface font-sans text-base leading-[1.6] text-ink">
    <Mascots />
    <div class="hazard" aria-hidden="true"></div>
    <Header />
    <main class="mx-auto max-w-[1264px] border-x border-line">
      <slot />
    </main>
    <Footer />
  </body>
</html>
