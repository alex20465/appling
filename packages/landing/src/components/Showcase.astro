---
// The read only inspector, built by @appling/inspect as a browser only demo and copied to /inspect/ by the build
---

<section id="showcase" class="border-t border-line px-4 py-16 sm:px-8">
  <div class="mx-auto flex max-w-[1200px] flex-col gap-8">
    <div class="flex max-w-[640px] flex-col gap-3">
      <span class="eyebrow">Try it</span>
      <h2 class="text-h1">Inspect the model, right here</h2>
      <p class="text-ink-soft">The read only inspector on the sample sales and CRM model, running in your browser. Unfold the canvas and select a node: the inspector shows what it does, who may run it and where it is used. Nothing leaves this page.</p>
    </div>
    <div class="overflow-hidden rounded-sm border border-line bg-surface-raised">
      <div class="flex items-center justify-between gap-4 border-b border-line px-4 py-2 font-mono text-xs leading-5 text-ink-muted">
        <span class="truncate">Appling Inspect · examples</span>
        <a href="/inspect/" target="_blank" class="font-semibold whitespace-nowrap">Open full screen →</a>
      </div>
      <div id="inspect-stage" class="relative h-[min(760px,80vh)] min-h-[480px] bg-surface">
        <div aria-hidden="true" class="absolute inset-0 opacity-60">
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_2px_2px,var(--color-line)_1.2px,transparent_1.5px)] bg-size-[20px_20px]"></div>
          <div class="absolute top-6 right-6 bottom-6 w-[min(360px,40%)] rounded-lg border border-line bg-surface-raised max-sm:hidden"></div>
        </div>
        <div class="absolute inset-0 flex flex-col items-center justify-center gap-4 px-6 text-center">
          <button type="button" class="inline-flex min-h-11 cursor-pointer items-center rounded-md bg-leaf px-6 font-mono text-[13px] leading-4 font-semibold text-on-leaf hover:bg-leaf-hover">Try the demo</button>
          <p class="max-w-[420px] text-sm leading-[22px] text-ink-muted">Loads the model canvas and the sample model. Read only: nothing is edited or generated.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const stage = document.querySelector("#inspect-stage")!;
  stage.querySelector("button")!.addEventListener("click", () => {
    const frame = document.createElement("iframe");
    frame.src = "/inspect/";
    frame.title = "The Appling inspector on the sample model";
    frame.className = "absolute inset-0 size-full border-0";
    stage.replaceChildren(frame);
    frame.focus();
  });
</script>
