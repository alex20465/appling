---
const commands = [
  { name: "init", text: "sets up a project, connects Claude Code, Codex, OpenCode, Gemini CLI or Antigravity CLI and picks the stack." },
  { name: "check", text: "validates every .appling file and exits with 1 when it finds errors." },
  { name: "fmt", text: "rewrites files into canonical form. A second run changes nothing." },
  { name: "graph", text: "prints the semantic graph as JSON, the same graph the inspector and the AI read." },
  { name: "generate", text: "writes a draft project for every target in appling.config.json." },
];

const lines = [
  { comment: "start a project, it asks for the name, the agents and the stack", command: "npx @appling/cli init todo" },
  { comment: "or answer up front: Claude Code and Codex on Django", command: "npx @appling/cli init todo --name todo --agents claude,codex --stack django" },
  { comment: "OpenCode on Ash, the stack can also wait (--stack none)", command: "npx @appling/cli init shop --name shop --agents opencode --stack ash" },
  { comment: "inside the project folder, validate the model", command: "npx appling check models" },
  { comment: "preview the generated project", command: "npx appling generate --plan" },
];
---

<section id="cli" class="border-t border-line px-4 py-16 sm:px-8">
  <div id="start" class="mx-auto flex max-w-[1200px] flex-wrap items-start gap-12">
    <div class="flex min-w-0 flex-[1_1_360px] flex-col gap-3">
      <span class="eyebrow">Get started</span>
      <h2 class="text-h1">Init, model, generate</h2>
      <p class="text-ink-soft">One command sets up the project and wires your coding agent to the model. Then describe what you want; the agent writes the model first and the code from it.</p>
      <div class="flex flex-col gap-2 pt-2">
        {commands.map((command) => (
          <p class="text-sm leading-[22px] text-ink-muted">
            <code class="rounded-sm border border-line bg-surface-elevated px-1.5 font-mono text-xs text-ink">{command.name}</code>{" "}{command.text}
          </p>
        ))}
      </div>
      <div class="flex flex-wrap gap-x-6 gap-y-2 pt-2 font-mono text-[13px] leading-5 font-semibold">
        <a href="/docs/getting-started/new-project/">Start a new project →</a>
        <a href="/docs/getting-started/first-model/">Write your first model →</a>
      </div>
    </div>
    <div class="min-w-0 flex-[1_1_520px] overflow-hidden rounded-sm border border-line bg-surface-raised">
      <div class="border-b border-line px-4 py-2 font-mono text-xs leading-5 text-ink-muted">terminal</div>
      <div class="flex flex-col gap-3 overflow-x-auto p-6 text-code">
        {lines.map((line, i) => (
          <>
            <span class="text-ink-muted"># {line.comment}</span>
            <span class="whitespace-nowrap">
              <span class="type inline-block" style={`animation-delay: ${0.2 + i * 1.2}s`}><span class="text-leaf">$ </span>{line.command}</span>
              {i === lines.length - 1 && <span class="cursor"></span>}
            </span>
          </>
        ))}
      </div>
    </div>
  </div>
</section>
