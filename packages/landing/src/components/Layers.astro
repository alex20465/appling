---
const tiers = [
  { n: 1, color: "#173d24", text: "#fafafa", textAt: "150 407", top: "280,164 539.8,314 280,464 20.2,314", left: "20.2,314 280,464 280,500 20.2,350", right: "280,464 539.8,314 539.8,350 280,500" },
  { n: 2, color: "#1f6b2c", text: "#fafafa", textAt: "174 357", top: "280,156 491.3,278 280,400 68.7,278", left: "68.7,278 280,400 280,436 68.7,314", right: "280,400 491.3,278 491.3,314 280,436" },
  { n: 3, color: "#2e7d3a", text: "#fafafa", textAt: "199 307", top: "280,148 442.8,242 280,336 117.2,242", left: "117.2,242 280,336 280,372 117.2,278", right: "280,336 442.8,242 442.8,278 280,372" },
  { n: 4, color: "#5cbf63", text: "#080808", textAt: "223 257", top: "280,140 394.3,206 280,272 165.7,206", left: "165.7,206 280,272 280,308 165.7,242", right: "280,272 394.3,206 394.3,242 280,308" },
  { n: 5, color: "#a6dc5a", text: "#080808", textAt: "247 207", top: "280,132 345.8,170 280,208 214.2,170", left: "214.2,170 280,208 280,244 214.2,206", right: "280,208 345.8,170 345.8,206 280,244" },
];

const legend = [
  { n: 5, color: "#a6dc5a", label: "L5 Experience", title: "How people reach it", members: "page · navigation · flow · messages" },
  { n: 4, color: "#5cbf63", label: "L4 Interfaces", title: "How programs reach it", members: "interface" },
  { n: 3, color: "#2e7d3a", label: "L3 Application", title: "How capabilities are organized", members: "query · projection · external · usecase" },
  { n: 2, color: "#1f6b2c", label: "L2 Behavior", title: "What can happen", members: "event · action · machine · job" },
  { n: 1, color: "#173d24", label: "L1 Domain", title: "What exists", members: "enum · value · entity · invariant · policy" },
];
---

<section id="layers" class="border-t border-line px-4 py-16 sm:px-8">
  <div class="mx-auto flex max-w-[1200px] flex-col gap-8">
    <div class="flex max-w-[640px] flex-col gap-3">
      <span class="eyebrow">Architecture</span>
      <h2 class="text-h1">Five layers, one model</h2>
      <p class="text-ink-soft">Each concept is defined once, in the layer that owns it. References only point down the layers, and modules only see what other modules export.</p>
    </div>
    <div class="flex flex-wrap items-center gap-12">
      <div class="min-w-0 max-w-[600px] flex-[1_1_460px]">
        <svg viewBox="0 80 560 440" role="img" aria-label="A stepped pyramid of five layers, L1 Domain at the base up to L5 Experience at the top, ringed by cross-cutting concerns" class="block h-auto w-full">
          <ellipse class="sr ref" cx="280" cy="350" rx="275" ry="160" stroke="#6b6b6b" stroke-width="2" style="animation-delay: 0s, 0s"></ellipse>
          {tiers.map((tier) => (
            <g class="tier" style={`animation-delay: ${(tier.n - 1) * 0.15}s`}>
              <g class="lift" data-layer={tier.n}>
                <polygon class="f-top" points={tier.top} fill={tier.color}></polygon>
                <polygon points={tier.left} fill={tier.color}></polygon>
                <polygon class="f-right" points={tier.right} fill={tier.color}></polygon>
                <text class="facetxt" transform={`matrix(0.866 0.5 0 1 ${tier.textAt})`} fill={tier.text}>L{tier.n}</text>
                {tier.n === 5 && (
                  <>
                    <path class="sr draw" pathLength="1" d="M280 172 C279 152 282 130 280 106" stroke="#2e7d3a" stroke-width="4" style="animation-delay: 1.2s"></path>
                    <g transform="translate(280 128) rotate(-150) scale(.8)"><path class="leafp" d="M0 0 C10 -12 30 -12 40 0 C30 12 10 12 0 0 Z" fill="#5cbf63" style="animation-delay: 1.8s"></path></g>
                    <g transform="translate(280 114) rotate(-35) scale(.8)"><path class="leafp" d="M0 0 C10 -12 30 -12 40 0 C30 12 10 12 0 0 Z" fill="#2e7d3a" style="animation-delay: 1.95s"></path></g>
                  </>
                )}
              </g>
            </g>
          ))}
        </svg>
      </div>

      <div class="flex min-w-0 flex-[1_1_400px] flex-col gap-1">
        {legend.map((layer) => (
          <article class="legend flex items-start gap-4 rounded-md px-4 py-3" data-layer={layer.n}>
            <svg viewBox="0 0 28 28" aria-hidden="true" class="mt-1 size-7 flex-none">
              <polygon class="f-top" points="14,3 25,9 14,15 3,9" fill={layer.color}></polygon>
              <polygon points="3,9 14,15 14,26 3,20" fill={layer.color}></polygon>
              <polygon class="f-right" points="14,15 25,9 25,20 14,26" fill={layer.color}></polygon>
            </svg>
            <div class="flex min-w-0 flex-col gap-0.5">
              <span class="eyebrow">{layer.label}</span>
              <h3 class="text-[17px] leading-6 font-semibold">{layer.title}</h3>
              <code class="text-code text-ink-muted">{layer.members}</code>
            </div>
          </article>
        ))}
        <article class="flex items-start gap-4 rounded-md px-4 py-3">
          <svg viewBox="0 0 28 28" aria-hidden="true" class="mt-1 size-7 flex-none">
            <ellipse class="sr" cx="14" cy="14" rx="12" ry="7" stroke="#6b6b6b" stroke-width="2" stroke-dasharray="3 3"></ellipse>
          </svg>
          <div class="flex min-w-0 flex-col gap-0.5">
            <span class="eyebrow">Cross cutting</span>
            <h3 class="text-[17px] leading-6 font-semibold">Modules, access, evolution</h3>
            <code class="text-code text-ink-muted">module · role · actor · tenant · migration</code>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>

<script>
  const parts = document.querySelectorAll<HTMLElement | SVGElement>("[data-layer]");

  for (const part of parts) {
    part.addEventListener("mouseenter", () => {
      for (const other of parts) other.classList.toggle("on", other.dataset.layer === part.dataset.layer);
    });
    part.addEventListener("mouseleave", () => {
      for (const other of parts) other.classList.remove("on");
    });
  }
</script>
