---
import { GITHUB_URL } from "../links";

const source = `<span class="kw">module</span> sales <span class="pu">{</span>
  <span class="kw">export</span> <span class="ty">Order</span>

  <span class="kw">enum</span> <span class="ty">OrderStatus</span> <span class="pu">{</span>
    <span class="va">draft</span>
    <span class="va">placed</span>
  <span class="pu">}</span>

  <span class="kw">entity</span> <span class="ty">Order</span> <span class="pu">{</span>
    reference<span class="pu">:</span> <span class="ty">String</span> <span class="kw">unique</span>
    status<span class="pu">:</span> <span class="ty">OrderStatus</span> <span class="kw">state</span> <span class="kw">default</span> <span class="va">draft</span>
  <span class="pu">}</span>

  <span class="kw">action</span> <span class="ty">PlaceOrder</span> <span class="kw">on</span> <span class="ty">Order</span> <span class="pu">{</span>
    <span class="kw">requires</span> <span class="pu">{</span> reference <span class="pu">!=</span> <span class="st">""</span> <span class="pu">}</span>
  <span class="pu">}</span>

  <span class="kw">machine</span> <span class="ty">OrderFlow</span> <span class="kw">on</span> <span class="ty">Order</span><span class="pu">.</span>status <span class="pu">{</span>
    <span class="kw">transition</span> <span class="va">draft</span> <span class="pu">-&gt;</span> <span class="va">placed</span> <span class="kw">via</span> <span class="ty">PlaceOrder</span>
  <span class="pu">}</span>
<span class="pu">}</span>`;

// Symmetric layout in a 336 x 284 viewBox: Behavior (L2) on top, Domain (L1) below, every node 132 x 56
const W = 132;
const H = 56;
const nodes = [
  { x: 8, y: 20, kind: "L2 · ACTION", name: "PlaceOrder", delay: 0.2 },
  { x: 196, y: 20, kind: "L2 · MACHINE", name: "OrderFlow", delay: 0.3 },
  { x: 102, y: 120, kind: "L1 · ENTITY", name: "sales.Order", delay: 0, highlight: true },
  { x: 102, y: 220, kind: "L1 · ENUM", name: "OrderStatus", delay: 0.1 },
];

// Each edge starts on a port at its source border and ends where the arrow tip touches the target
const edges = [
  { from: [74, 76], d: "M74 76 C74 100 138 96 138 119", delay: 0.6, label: { x: 100, y: 98, text: "on", anchor: "end" } },
  { from: [262, 76], d: "M262 76 C262 100 198 96 198 119", delay: 0.8, label: { x: 236, y: 98, text: "on status", anchor: "start" } },
  { from: [196, 48], d: "M196 48 L141 48", delay: 1, label: { x: 168, y: 48, text: "via", anchor: "middle" } },
  { from: [168, 176], d: "M168 176 L168 219", delay: 1.2, label: { x: 176, y: 198, text: "status", anchor: "start" } },
];

const quotes = [
  "[CUSTOMER QUOTE: what Appling changed for their team]",
  "[CUSTOMER QUOTE: a concrete before and after]",
];
---

<section id="example" class="border-t border-line px-4 py-16 sm:px-8">
  <div class="mx-auto flex max-w-[1200px] flex-col gap-8">
    <div class="flex max-w-[640px] flex-col gap-3">
      <span class="eyebrow">Example</span>
      <h2 class="text-h1">One file in, one linked model out</h2>
      <p class="text-ink-soft">The same sales module, as text and as the graph Appling builds from it.</p>
    </div>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,440px),1fr))] gap-px border border-line bg-line">
      <div class="min-w-0 bg-surface-raised">
        <div class="flex justify-between gap-4 border-b border-line px-4 py-2 font-mono text-xs leading-5">
          <span class="text-ink-muted">sales.appling</span>
          <span class="flex items-center gap-2 text-leaf"><span class="size-1.5 rounded-full bg-leaf"></span>valid</span>
        </div>
        <pre class="overflow-x-auto p-6 text-code" set:html={source}></pre>
      </div>
      <div class="flex min-w-0 flex-col gap-4 bg-surface-raised p-6">
        <span class="eyebrow">The graph</span>
        <div class="grid flex-1 place-items-center">
          <svg viewBox="0 0 336 284" aria-hidden="true" class="block w-full max-w-[400px]">
            <defs>
              <marker id="ah" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" fill="#7a6e5e"></path></marker>
            </defs>
            {edges.map((edge) => (
              <g>
                <path class="sr ref edge" d={edge.d} stroke="#7a6e5e" stroke-width="1.5" style={`animation-delay: 0s, ${edge.delay}s`}></path>
                <circle class="appear" cx={edge.from[0]} cy={edge.from[1]} r="2.5" fill="#7a6e5e" style={`animation-delay: ${edge.delay}s`}></circle>
                <text class="edgelabel appear fill-ink-muted font-mono text-[10.5px]" x={edge.label.x} y={edge.label.y} text-anchor={edge.label.anchor} dominant-baseline="central" style={`animation-delay: ${edge.delay}s`}>{edge.label.text}</text>
              </g>
            ))}
            {nodes.map((node) => (
              <g class="node" style={`animation-delay: ${node.delay}s`}>
                <rect x={node.x} y={node.y} width={W} height={H} rx="4" fill={node.highlight ? "#142215" : "#1b1712"} stroke={node.highlight ? "#5cbf6366" : "#7a6e5e"} vector-effect="non-scaling-stroke"></rect>
                <text x={node.x + 12} y={node.y + 22} class:list={["font-mono text-[10px] font-semibold tracking-[0.1em]", node.highlight ? "fill-rust" : "fill-ink-muted"]}>{node.kind}</text>
                <text x={node.x + 12} y={node.y + 40} class="fill-ink font-mono text-[13px]">{node.name}</text>
                {node.highlight && (
                  <g>
                    <rect x={node.x + W - 52} y={node.y + H - 7} width="40" height="14" rx="7" fill="#5cbf63"></rect>
                    <text x={node.x + W - 32} y={node.y + H} text-anchor="middle" dominant-baseline="central" class="fill-on-leaf font-mono text-[8px] font-semibold tracking-[0.06em]">EXPORT</text>
                  </g>
                )}
              </g>
            ))}
          </svg>
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-6 pt-8">
      <div class="flex flex-col gap-3">
        <span class="eyebrow">What people say</span>
        <h3 class="text-[21.6px] leading-[26px] font-semibold tracking-[-0.015em]">Proof from real projects</h3>
      </div>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-px border border-line bg-line">
        {quotes.map((quote) => (
          <figure class="flex flex-col gap-4 bg-surface-raised p-6">
            <blockquote class="text-ink-soft">{quote}</blockquote>
            <figcaption class="font-mono text-xs leading-5 text-leaf">[NAME], [ROLE], [COMPANY]</figcaption>
          </figure>
        ))}
        <a href={`${GITHUB_URL}/tree/main/examples`} class="flex flex-col justify-between gap-4 bg-leaf-soft p-6 text-ink no-underline hover:text-ink">
          <span class="eyebrow">Example repository</span>
          <span class="text-[21.6px] leading-[26px] font-semibold tracking-[-0.015em]">Browse full models on GitHub</span>
          <span class="font-mono text-xs leading-5 text-ink-muted">alex20465/appling/examples →</span>
        </a>
      </div>
    </div>
  </div>
</section>
