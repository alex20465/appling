---
import { buildSources, errorsOf, type Model } from "@appling/lang";
import { buildGraph } from "@appling/model";
import { GITHUB_URL } from "../links";
import Story from "./Story.astro";

const source = `<span class="kw">module</span> sales <span class="pu">{</span>
  <span class="kw">export</span> <span class="ty">Order</span>

  <span class="kw">enum</span> <span class="ty">OrderStatus</span> <span class="pu">{</span>
    <span class="va">draft</span>
    <span class="va">placed</span>
  <span class="pu">}</span>

  <span class="kw">entity</span> <span class="ty">Order</span> <span class="pu">{</span>
    reference<span class="pu">:</span> <span class="ty">String</span> <span class="kw">unique</span>
    status<span class="pu">:</span> <span class="ty">OrderStatus</span> <span class="kw">state</span> <span class="kw">default</span> <span class="va">draft</span>
  <span class="pu">}</span>

  <span class="kw">action</span> <span class="ty">PlaceOrder</span> <span class="kw">on</span> <span class="ty">Order</span> <span class="kw">does</span> <span class="st">"Emails the order confirmation"</span> <span class="pu">{</span>
    <span class="kw">requires</span> <span class="pu">{</span> reference <span class="pu">!=</span> <span class="st">""</span> <span class="pu">}</span>
  <span class="pu">}</span>

  <span class="kw">machine</span> <span class="ty">OrderFlow</span> <span class="kw">on</span> <span class="ty">Order</span><span class="pu">.</span>status <span class="pu">{</span>
    <span class="kw">transition</span> <span class="va">draft</span> <span class="pu">-&gt;</span> <span class="va">placed</span> <span class="kw">via</span> <span class="ty">PlaceOrder</span>
  <span class="pu">}</span>
<span class="pu">}</span>`;

// The canvas beside the text is the real one, drawn from this very source
const workspace = await buildSources({ "file:///sales.appling": source.replace(/<[^>]+>/g, "").replaceAll("&gt;", ">") });
const errors = errorsOf(workspace);
if (errors.length) throw new Error(`The example has errors:\n${errors.join("\n")}`);
const graph = buildGraph(workspace.documents.map((doc) => doc.parseResult.value as Model), workspace.services);
---

<section id="example" class="px-4 py-16 sm:px-8">
  <div class="mx-auto flex max-w-[1200px] flex-col gap-8">
    <div class="flex max-w-[640px] flex-col gap-3">
      <span class="eyebrow">Example</span>
      <h2 class="text-h1">The canvas</h2>
      <p class="text-ink-soft">A sales module as text, and the model on the canvas of the inspector. Unfold a bud and select a node to see what it does, who may run it and where it is used.</p>
    </div>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,440px),1fr))] gap-4">
      <div class="min-w-0 overflow-hidden rounded-lg bg-surface-raised">
        <div class="flex justify-between gap-4 border-b border-line px-4 py-2 font-mono text-xs leading-5">
          <span class="text-ink-muted">sales.appling</span>
          <span class="flex items-center gap-2 text-leaf"><span class="size-1.5 rounded-full bg-leaf"></span>valid</span>
        </div>
        <pre class="overflow-x-auto p-6 text-code" set:html={source}></pre>
      </div>
      <div class="flex min-h-[520px] min-w-0 flex-col overflow-hidden rounded-lg bg-surface-raised">
        <div class="flex justify-between gap-4 border-b border-line px-4 py-2 font-mono text-xs leading-5">
          <span class="truncate text-ink-muted">Appling Inspect · sales</span>
          <a href="/inspect/" target="_blank" rel="noopener" class="font-semibold no-underline">Full demo →</a>
        </div>
        <Story view="levels" element="sales.Order" graph={graph} name="sales" class="flex-1" />
      </div>
    </div>

    <a href={`${GITHUB_URL}/tree/main/examples`} class="font-mono text-[13px] leading-5 font-semibold">Browse full models on GitHub →</a>
  </div>
</section>
