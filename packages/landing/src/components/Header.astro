---
import Bot from "./Bot.astro";
import { GITHUB_URL, NPM_URL } from "../links";

const sections = [
  { href: "/#layers", label: "Layers" },
  { href: "/#how", label: "How it works" },
  { href: "/#tools", label: "Toolchain" },
  { href: "/#example", label: "Example" },
  { href: "/#roadmap", label: "Roadmap" },
  { href: "/docs/", label: "Docs" },
];
const links = [...sections, { href: GITHUB_URL, label: "GitHub" }];

const cta = "inline-flex min-h-11 items-center rounded-md bg-leaf px-4 font-mono text-[13px] leading-4 font-semibold text-on-leaf no-underline hover:bg-leaf-hover hover:text-on-leaf";
const toggle = "burger inline-flex min-h-11 cursor-pointer items-center gap-3 font-mono text-[13px] leading-4 font-semibold text-ink-muted hover:text-ink";

// The sprout artwork (474 x 560) has 17px of transparent space on its right and 85px on top: the menu bot's
// right edge meets the content edge and its speech bubble floats just above the antenna.
---

<header class="border-b border-line px-4">
  <nav aria-label="Main" class="mx-auto flex max-w-[1200px] items-center justify-between gap-4 py-3">
    <a href="/#top" class="flex items-center gap-2 text-ink no-underline">
      <img src="/appling-icon.svg" alt="" class="sprout size-7" />
      <span class="intro text-[17px] leading-6 font-semibold" style="animation-delay: 500ms">Appling</span>
    </a>
    <div class="flex items-center gap-6 max-lg:hidden">
      {links.map((link) => <a href={link.href} class="font-mono text-xs leading-[19px] font-medium text-ink-muted no-underline hover:text-ink">{link.label}</a>)}
      <a href="/#start" class={cta}>Get started</a>
    </div>
    <button type="button" popovertarget="menu" class={`${toggle} lg:hidden`}>Menu<span class="knob" aria-hidden="true"><span class="bars"><span></span><span></span><span></span></span></span></button>
  </nav>
</header>

<div id="menu" popover aria-label="Menu" class="menu fixed inset-0 m-0 size-full max-h-none max-w-none overflow-y-auto border-0 p-0 text-ink lg:hidden">
  <div class="flex min-h-full flex-col">
    <div class="hazard" aria-hidden="true"></div>
    <div class="border-b border-line px-4">
      <div class="mx-auto flex max-w-[1200px] items-center justify-between gap-4 py-3">
        <a href="/#top" class="flex items-center gap-2 text-ink no-underline">
          <img src="/appling-icon.svg" alt="" class="size-7" />
          <span class="text-[17px] leading-6 font-semibold">Appling</span>
        </a>
        <button type="button" popovertarget="menu" popovertargetaction="hide" class={toggle}>Close<span class="knob" aria-hidden="true"><span class="bars"><span></span><span></span><span></span></span></span></button>
      </div>
    </div>

    <nav aria-label="Sections" class="px-4 pt-7">
      <span class="rise eyebrow" style="--i: 0">Navigate</span>
      <ul class="mt-3 border-t border-line">
        {sections.map((link, i) => (
          <li class="rise border-b border-line" style={`--i: ${i + 1}`}>
            <a href={link.href} class="menu-link flex items-center gap-4 py-3 text-ink no-underline">
              <span class="w-5 font-mono text-xs leading-[19px] text-ink-muted">{String(i + 1).padStart(2, "0")}</span>
              <span class="label text-[clamp(28px,9vw,40px)] leading-[1.2] font-semibold tracking-[-0.03em]">{link.label}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true" class="arrow ml-auto size-6">
                <path class="sr" d="M3 12h20 M17 6l6 6-6 6" stroke="currentColor" stroke-width="2"></path>
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mt-auto flex items-end justify-between gap-4 overflow-hidden px-4 pt-10">
      <div class="rise flex flex-col gap-4 pb-8" style={`--i: ${sections.length + 1}`}>
        <a href="/#start" class={cta}>Get started</a>
        <div class="flex gap-6 font-mono text-xs leading-[19px] font-medium">
          <a href={GITHUB_URL} class="text-ink-muted hover:text-ink">GitHub</a>
          <a href={NPM_URL} class="text-ink-muted hover:text-ink">npm</a>
        </div>
      </div>
      <div class="menu-bot relative -mb-10 w-(--w) shrink-0 [--w:clamp(140px,22vh,200px)] -mr-[calc(var(--w)*17/474)] [@media(max-height:620px)]:hidden" aria-hidden="true">
        <span class="bubble absolute right-[calc(var(--w)*17/474)] bottom-[calc(100%-var(--w)*85/474+10px)] rounded-full border border-leaf-line bg-surface-elevated px-3 py-1 font-mono text-xs leading-5 whitespace-nowrap text-ink">Where to, human?</span>
        <div class="relative">
          <Bot name="sprout" />
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const menu = document.getElementById("menu")!;

  // Every link lands on this page or leaves it, so the panel has done its job
  for (const link of menu.querySelectorAll("a")) {
    link.addEventListener("click", () => menu.hidePopover());
  }
  matchMedia("(min-width: 64rem)").addEventListener("change", () => menu.hidePopover());
</script>
