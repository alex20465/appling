---
import { SECTIONS, docHref } from "../docs";

interface Props {
  current: string;
  titles: Map<string, string>;
}

const { current, titles } = Astro.props;
---

<nav aria-label="Documentation" class="flex flex-col gap-6">
  {SECTIONS.map((section) => (
    <div class="flex flex-col gap-2">
      <span class="eyebrow">{section.label}</span>
      <ul class="flex flex-col border-l border-line">
        {section.pages.map((id) => (
          <li>
            <a
              href={docHref(id)}
              aria-current={id === current ? "page" : undefined}
              class="-ml-px block border-l border-transparent py-1 pl-3 text-sm leading-[22px] text-ink-muted no-underline hover:border-line-strong hover:text-ink aria-[current=page]:border-leaf aria-[current=page]:text-ink"
            >
              {titles.get(id)}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</nav>
