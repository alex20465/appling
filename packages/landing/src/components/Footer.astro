---
import { GITHUB_URL, NPM_URL } from "../links";
---

<div class="hazard" aria-hidden="true"></div>
<footer class="px-4 py-12">
  <div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-6">
    <div class="flex items-center gap-2">
      <img src="/appling-icon.svg" alt="" class="size-7" />
      <span class="text-[17px] leading-6 font-semibold">Appling</span>
    </div>
    <div class="flex flex-wrap gap-6 font-mono text-xs leading-[19px] font-medium">
      <span class="text-ink-muted">MIT licensed</span>
      <a href="/docs/" class="text-ink-muted hover:text-ink">Docs</a>
      <a href={GITHUB_URL} class="text-ink-muted hover:text-ink">GitHub</a>
      <a href={NPM_URL} class="text-ink-muted hover:text-ink">npm</a>
      <button type="button" data-consent-open class="cursor-pointer text-ink-muted hover:text-ink">Cookie settings</button>
    </div>
  </div>
</footer>
